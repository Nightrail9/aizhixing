---
import Logo from './Logo.astro';
const base=import.meta.env.BASE_URL;
---
<footer><div class="container footer-grid"><div><Logo/><p>持续学习，认真行动，记录每一次认知生长。</p></div><nav aria-label="页脚导航"><a href={`${base}articles/`}>文章</a><a href={`${base}tutorials/`}>教程</a><a href={`${base}resources/`}>资源</a><a href={`${base}search/`}>搜索</a></nav><p class="copyright">© {new Date().getFullYear()} Nightrail9 · Built with Astro</p></div></footer>
<style>footer{padding:2.5rem 0;margin-top:2rem;border-top:1px solid var(--line);background:var(--surface)}.footer-grid{display:grid;grid-template-columns:1fr auto;gap:1rem;align-items:center}.footer-grid>div>p,.copyright{margin:.7rem 0 0;color:var(--muted);font-size:.82rem}.footer-grid nav{display:flex;gap:1rem;color:var(--muted);font-size:.9rem}.copyright{grid-column:1/-1;border-top:1px solid var(--line);padding-top:1rem}@media(max-width:640px){.footer-grid{grid-template-columns:1fr}.footer-grid nav{flex-wrap:wrap}}</style>
