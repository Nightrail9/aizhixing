---
import Picture from './ResponsiveImage.astro';
import { CalendarDays, Eye } from 'lucide-astro';
import type { ImageMetadata } from 'astro';
interface Props{href:string;title:string;description:string;image:ImageMetadata;alt:string;date?:string;views?:number|string;tags?:string[];badge?:string}
const{href,title,description,image,alt,date,views,tags=[],badge}=Astro.props;
---
<article class="content-card surface" data-tags={tags.join('|')}><a href={href} tabindex="-1"><Picture src={image} alt={alt} formats={['avif','webp']} widths={[420,720]} sizes="(max-width: 640px) 100vw, (max-width: 960px) 50vw, 33vw"/></a><div class="card-body">{badge&&<span class="pill">{badge}</span>}<h3><a href={href}>{title}</a></h3><p>{description}</p><div class="meta">{date&&<span><CalendarDays size={14}/> {date}</span>}{views&&<span><Eye size={14}/> {views}</span>}</div><div class="tag-row">{tags.slice(0,3).map((tag)=><span class="pill">{tag}</span>)}</div></div></article>
<style>.meta span{display:inline-flex;align-items:center;gap:.3rem}</style>
