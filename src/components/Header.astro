---
import { Github, Menu, Moon, Search, Sun, X } from 'lucide-astro';
import Logo from './Logo.astro';

const path = Astro.url.pathname;
const base = import.meta.env.BASE_URL;
const nav = [
  { label: '首页', href: base },
  { label: '文章', href: `${base}articles/` },
  { label: '教程', href: `${base}tutorials/` },
  { label: '资源', href: `${base}resources/` },
];
const active = (href: string) => href === base ? path === base : path.startsWith(href);
---

<header class="site-header">
  <div class="container header-inner">
    <Logo />
    <nav class="desktop-nav" aria-label="主导航">
      {nav.map((item) => <a href={item.href} aria-current={active(item.href) ? 'page' : undefined}>{item.label}</a>)}
    </nav>
    <div class="header-actions">
      <a class="search-link" href={`${base}search/`} aria-label="搜索文章、教程或资源"><span>搜索文章、教程或资源...</span><Search size={18} /></a>
      <a class="round-button github-button" href="https://github.com/Nightrail9/aizhixing" target="_blank" rel="noreferrer" aria-label="访问 GitHub 仓库"><Github size={20} /></a>
      <div class="theme-actions" aria-label="主题选择">
        <button class="round-button" type="button" data-set-theme="light" aria-label="使用浅色主题"><Sun size={20} /></button>
        <button class="round-button" type="button" data-set-theme="dark" aria-label="使用深色主题"><Moon size={19} /></button>
      </div>
      <details class="mobile-menu">
        <summary class="round-button" aria-label="打开导航"><Menu class="menu-open" size={21} /><X class="menu-close" size={21} /></summary>
        <div class="mobile-menu-panel surface">
          {nav.map((item) => <a href={item.href} aria-current={active(item.href) ? 'page' : undefined}>{item.label}</a>)}
          <a href={`${base}search/`}>搜索</a>
          <div class="mobile-theme"><span>外观</span><button type="button" data-set-theme="light"><Sun size={17} /> 浅色</button><button type="button" data-set-theme="dark"><Moon size={17} /> 深色</button></div>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  const applyTheme = (theme: 'light' | 'dark') => {
    document.documentElement.classList.toggle('dark', theme === 'dark');
    localStorage.setItem('aizhixing:theme:v1', theme);
    document.querySelectorAll<HTMLButtonElement>('[data-set-theme]').forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.setTheme === theme)));
    document.querySelector<HTMLIFrameElement>('.giscus-frame')?.contentWindow?.postMessage({ giscus: { setConfig: { theme } } }, 'https://giscus.app');
  };
  document.querySelectorAll<HTMLButtonElement>('[data-set-theme]').forEach((button) => button.addEventListener('click', () => applyTheme(button.dataset.setTheme as 'light' | 'dark')));
  applyTheme(document.documentElement.classList.contains('dark') ? 'dark' : 'light');
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: 70; border-bottom: 1px solid var(--line); background: color-mix(in srgb, var(--surface-solid) 92%, transparent); backdrop-filter: blur(16px); }
  .header-inner { height: 4.65rem; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1.5rem; }
  .desktop-nav { height: 100%; display: flex; align-items: stretch; gap: 2.45rem; }
  .desktop-nav a { position: relative; display: grid; place-items: center; font-weight: 800; font-size: .94rem; }
  .desktop-nav a[aria-current='page'] { color: var(--brand); }
  .desktop-nav a[aria-current='page']::after { content: ''; position: absolute; bottom: 0; left: 7%; right: 7%; height: 3px; border-radius: 3px 3px 0 0; background: var(--brand); }
  .header-actions { justify-self: end; display: flex; align-items: center; gap: .45rem; }
  .search-link { width: 15.5rem; height: 2.45rem; display: flex; align-items: center; justify-content: space-between; gap: .5rem; padding: 0 .85rem 0 1rem; border: 1px solid var(--line); border-radius: 999px; color: var(--muted); background: var(--surface-solid); font-size: .76rem; }
  .round-button { width: 2.45rem; height: 2.45rem; display: grid; place-items: center; flex: 0 0 auto; padding: 0; border: 1px solid var(--line); border-radius: 999px; color: var(--text); background: var(--surface-solid); cursor: pointer; }
  .round-button:hover, .round-button[aria-pressed='true'] { color: var(--brand); border-color: var(--brand-soft-border); background: var(--brand-soft); }
  .theme-actions { display: flex; gap: .35rem; }
  .mobile-menu { display: none; position: relative; }
  .mobile-menu summary { list-style: none; }
  .mobile-menu summary::-webkit-details-marker { display: none; }
  .menu-close { display: none; }
  .mobile-menu[open] .menu-open { display: none; }
  .mobile-menu[open] .menu-close { display: block; }
  .mobile-menu-panel { position: absolute; right: 0; top: 3rem; width: 13rem; display: grid; gap: .2rem; padding: .65rem; }
  .mobile-menu-panel > a { padding: .55rem .7rem; border-radius: .55rem; font-weight: 700; }
  .mobile-menu-panel > a:hover, .mobile-menu-panel > a[aria-current='page'] { color: var(--brand); background: var(--brand-soft); }
  .mobile-theme { display: grid; grid-template-columns: 1fr 1fr; gap: .35rem; margin-top: .35rem; padding-top: .55rem; border-top: 1px solid var(--line); }
  .mobile-theme span { grid-column: 1 / -1; color: var(--muted); font-size: .72rem; }
  .mobile-theme button { display: inline-flex; align-items: center; justify-content: center; gap: .3rem; padding: .45rem; border: 1px solid var(--line); border-radius: .5rem; background: transparent; color: var(--text); }
  @media (max-width: 1120px) { .header-inner { grid-template-columns: auto 1fr auto; } .desktop-nav { justify-self: center; gap: 1.5rem; } .search-link { width: 2.45rem; padding: 0; justify-content: center; } .search-link span { display: none; } }
  @media (max-width: 760px) { .header-inner { height: 4.25rem; grid-template-columns: 1fr auto; gap: .7rem; } .desktop-nav { display: none; } .mobile-menu { display: block; } }
  @media (max-width: 520px) { .github-button, .theme-actions { display: none; } }
</style>
