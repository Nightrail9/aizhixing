---
import { Github, Menu, Moon, Search, Sun } from 'lucide-astro';
import Logo from './Logo.astro';
const path = Astro.url.pathname;
const base = import.meta.env.BASE_URL;
const nav = [{ label: '首页', href: base },{ label: '文章', href: `${base}articles/` },{ label: '教程', href: `${base}tutorials/` },{ label: '资源', href: `${base}resources/` }];
const active = (href: string) => href === base ? path === base : path.startsWith(href);
---
<header class="site-header"><div class="container header-inner"><Logo/><nav aria-label="主导航">{nav.map((item)=><a href={item.href} aria-current={active(item.href)?'page':undefined}>{item.label}</a>)}</nav><div class="header-actions"><a class="search-link" href={`${base}search/`}><Search size={18}/><span>搜索文章、教程或资源</span></a><a class="icon-button github-button" href="https://github.com/Nightrail9/aizhixing" target="_blank" rel="noreferrer" aria-label="访问 GitHub 仓库"><Github size={21}/></a><button class="icon-button theme-toggle" type="button" aria-label="切换深浅色主题"><Sun class="sun" size={21}/><Moon class="moon" size={21}/></button><details class="mobile-menu"><summary class="icon-button" aria-label="打开导航"><Menu size={21}/></summary><div>{nav.map((item)=><a href={item.href}>{item.label}</a>)}<a href={`${base}search/`}>搜索</a></div></details></div></div></header>
<script>
  const button=document.querySelector<HTMLButtonElement>('.theme-toggle');
  const setTheme=(theme:'light'|'dark')=>{document.documentElement.classList.toggle('dark',theme==='dark');localStorage.setItem('aizhixing:theme:v1',theme);document.querySelector<HTMLIFrameElement>('.giscus-frame')?.contentWindow?.postMessage({giscus:{setConfig:{theme}}},'https://giscus.app')};
  button?.addEventListener('click',()=>setTheme(document.documentElement.classList.contains('dark')?'light':'dark'));
</script>
<style>.site-header{position:sticky;top:0;z-index:70;border-bottom:1px solid var(--line);background:color-mix(in srgb,var(--surface) 88%,transparent);backdrop-filter:blur(18px)}.header-inner{height:5.3rem;display:flex;align-items:center;justify-content:space-between;gap:1.5rem}.header-inner nav{display:flex;align-items:stretch;height:100%;gap:1.8rem}.header-inner nav a{position:relative;display:grid;place-items:center;font-weight:750}.header-inner nav a[aria-current="page"]{color:#0875ed}.header-inner nav a[aria-current="page"]::after{content:"";position:absolute;bottom:0;left:10%;right:10%;height:3px;border-radius:3px;background:#1687ff}.header-actions{display:flex;align-items:center;gap:.55rem}.search-link{display:flex;align-items:center;gap:.5rem;width:15rem;height:2.65rem;padding:0 .9rem;border:1px solid var(--line);border-radius:999px;color:var(--muted);font-size:.82rem}.icon-button{width:2.65rem;height:2.65rem;display:grid;place-items:center;border:1px solid var(--line);border-radius:999px;background:var(--surface);cursor:pointer}.moon{display:none}.dark .moon{display:block}.dark .sun{display:none}.mobile-menu{display:none;position:relative}.mobile-menu summary{list-style:none}.mobile-menu div{position:absolute;right:0;top:3rem;display:grid;min-width:10rem;padding:.5rem;background:var(--surface);border:1px solid var(--line);border-radius:.8rem;box-shadow:var(--shadow)}.mobile-menu div a{padding:.65rem;border-radius:.5rem}.mobile-menu div a:hover{background:var(--surface-soft)}@media(max-width:1050px){.search-link{width:2.65rem;padding:0;justify-content:center}.search-link span{display:none}}@media(max-width:760px){.header-inner{height:4.5rem}.header-inner nav{display:none}.mobile-menu{display:block}.brand :global(small){display:none}}@media(max-width:440px){.github-button{display:none}}</style>
