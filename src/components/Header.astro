---
import { Github, Menu, Moon, Search, Sun, X } from 'lucide-astro';
import Logo from './Logo.astro';

const path = Astro.url.pathname;
const base = import.meta.env.BASE_URL;
const nav = [
  { label: '首页', href: base },
  { label: '文章', href: `${base}articles/` },
  { label: '教程', href: `${base}tutorials/` },
  { label: '资源', href: `${base}resources/` },
];
const active = (href: string) => href === base ? path === base || path === `${base}/` : path.startsWith(href);
---

<header class="site-header">
  <div class="container header-inner">
    <Logo />
    <nav class="desktop-nav" aria-label="主导航">
      {nav.map((item) => (
        <a href={item.href} class:list={[{ 'is-active': active(item.href) }]} aria-current={active(item.href) ? 'page' : undefined}>
          {item.label}
          {active(item.href) && <span class="nav-indicator" />}
        </a>
      ))}
    </nav>
    <div class="header-actions">
      <a class="search-link" href={`${base}search/`} aria-label="搜索文章、教程或资源">
        <span>搜索文章、教程或资源...</span>
        <Search size={17} class="search-icon" />
      </a>
      <a class="round-button github-button" href="https://github.com/Nightrail9/aizhixing" target="_blank" rel="noreferrer" aria-label="访问 GitHub 仓库">
        <Github size={19} />
      </a>
      <div class="theme-toggle-wrapper" aria-label="主题选择">
        <button class="round-button theme-btn" type="button" data-set-theme="light" aria-label="使用浅色主题">
          <Sun size={18} />
        </button>
        <button class="round-button theme-btn" type="button" data-set-theme="dark" aria-label="使用深色主题">
          <Moon size={18} />
        </button>
      </div>
      <details class="mobile-menu">
        <summary class="round-button" aria-label="打开导航">
          <Menu class="menu-open" size={20} />
          <X class="menu-close" size={20} />
        </summary>
        <div class="mobile-menu-panel surface">
          {nav.map((item) => <a href={item.href} aria-current={active(item.href) ? 'page' : undefined}>{item.label}</a>)}
          <a href={`${base}search/`}>站内搜索</a>
          <div class="mobile-theme">
            <span>主题外观</span>
            <button type="button" data-set-theme="light"><Sun size={16} /> 浅色</button>
            <button type="button" data-set-theme="dark"><Moon size={16} /> 深色</button>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  const applyTheme = (theme: 'light' | 'dark') => {
    document.documentElement.classList.toggle('dark', theme === 'dark');
    localStorage.setItem('aizhixing:theme:v1', theme);
    document.querySelectorAll<HTMLButtonElement>('[data-set-theme]').forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.setTheme === theme)));
    document.querySelector<HTMLIFrameElement>('.giscus-frame')?.contentWindow?.postMessage({ giscus: { setConfig: { theme } } }, 'https://giscus.app');
  };
  document.querySelectorAll<HTMLButtonElement>('[data-set-theme]').forEach((button) => button.addEventListener('click', () => applyTheme(button.dataset.setTheme as 'light' | 'dark')));
  applyTheme(document.documentElement.classList.contains('dark') ? 'dark' : 'light');
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 70;
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    backdrop-filter: blur(16px);
  }
  .header-inner {
    height: 4.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .desktop-nav {
    height: 100%;
    display: flex;
    align-items: stretch;
    gap: 2.25rem;
  }
  .desktop-nav a {
    position: relative;
    display: flex;
    align-items: center;
    font-weight: 600;
    font-size: .95rem;
    color: var(--muted);
    transition: color .15s ease;
    padding-inline: .25rem;
  }
  .desktop-nav a:hover, .desktop-nav a.is-active {
    color: var(--brand);
  }
  .nav-indicator {
    position: absolute;
    bottom: .85rem;
    left: 50%;
    transform: translateX(-50%);
    width: 1.8rem;
    height: 3px;
    border-radius: 999px;
    background: var(--brand);
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: .65rem;
  }
  .search-link {
    width: 16.5rem;
    height: 2.45rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .5rem;
    padding: 0 1rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    background: var(--surface-soft);
    font-size: .84rem;
    transition: border-color .15s ease, background-color .15s ease;
  }
  .search-link:hover {
    border-color: var(--brand-soft-border);
    background: var(--surface);
  }
  .search-icon { color: var(--muted); }
  .round-button {
    width: 2.35rem;
    height: 2.35rem;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    background: var(--surface);
    cursor: pointer;
    transition: all .15s ease;
  }
  .round-button:hover, .round-button[aria-pressed='true'] {
    color: var(--brand);
    border-color: var(--brand-soft-border);
    background: var(--brand-soft);
  }
  .theme-toggle-wrapper {
    display: flex;
    align-items: center;
    gap: .3rem;
  }
  .mobile-menu {
    display: none;
    position: relative;
  }
  .mobile-menu summary { list-style: none; }
  .mobile-menu summary::-webkit-details-marker { display: none; }
  .menu-close { display: none; }
  .mobile-menu[open] .menu-open { display: none; }
  .mobile-menu[open] .menu-close { display: block; }
  .mobile-menu-panel {
    position: absolute;
    right: 0;
    top: 3rem;
    width: 13rem;
    display: grid;
    gap: .25rem;
    padding: .75rem;
    border-radius: .85rem;
  }
  .mobile-menu-panel > a {
    padding: .55rem .75rem;
    border-radius: .5rem;
    font-weight: 600;
  }
  .mobile-menu-panel > a:hover, .mobile-menu-panel > a[aria-current='page'] {
    color: var(--brand);
    background: var(--brand-soft);
  }
  .mobile-theme {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: .35rem;
    margin-top: .45rem;
    padding-top: .65rem;
    border-top: 1px solid var(--line);
  }
  .mobile-theme span {
    grid-column: 1 / -1;
    color: var(--muted);
    font-size: .75rem;
    font-weight: 600;
  }
  .mobile-theme button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .3rem;
    padding: .45rem;
    border: 1px solid var(--line);
    border-radius: .5rem;
    background: transparent;
    color: var(--text);
    font-size: .8rem;
    cursor: pointer;
  }

  @media (max-width: 1024px) {
    .desktop-nav { gap: 1.5rem; }
    .search-link { width: 13rem; }
  }
  @media (max-width: 768px) {
    .header-inner { height: 4.2rem; }
    .desktop-nav { display: none; }
    .search-link { width: 2.35rem; padding: 0; justify-content: center; }
    .search-link span { display: none; }
    .mobile-menu { display: block; }
  }
  @media (max-width: 520px) {
    .github-button, .theme-toggle-wrapper { display: none; }
  }
</style>
