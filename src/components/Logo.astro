---
const { compact = false } = Astro.props;
---
<a class="brand" href={import.meta.env.BASE_URL} aria-label="AI知行首页">
  <svg viewBox="0 0 64 44" role="img" aria-hidden="true"><defs><linearGradient id="brand-gradient" x1="0" y1="1" x2="1" y2="0"><stop stop-color="#00a8ff"/><stop offset="1" stop-color="#3b57ff"/></linearGradient></defs><path d="M2 38 22 10l9 14L41 4l21 34-18-7-10 9-11-9-21 7Z" fill="url(#brand-gradient)"/><path d="m22 10 1 21 11 9-3-16-9-14Zm19-6 3 27 18 7L41 4Z" fill="#086eea" opacity=".62"/></svg>
  {!compact && <span><strong>AI知行</strong><small>在学习中，看见更大的自己</small></span>}
</a>
<style>.brand{display:flex;align-items:center;gap:.7rem;min-width:max-content}.brand svg{width:3.3rem;height:2.25rem}.brand span{display:grid;line-height:1.18}.brand strong{font-size:1.18rem;letter-spacing:-.03em}.brand small{margin-top:.2rem;color:var(--muted);font-size:.72rem;font-weight:600}</style>
