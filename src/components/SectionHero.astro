---
import Picture from './ResponsiveImage.astro';
import banner from '../assets/images/banner-sections.png';
interface Props{eyebrow?:string;title:string;description:string;count?:string}
const{eyebrow,title,description,count}=Astro.props;
---
<section class="section-hero surface"><Picture src={banner} alt="蓝色雪山与湖泊" formats={['avif','webp']} widths={[720,1200,1800]} sizes="(max-width: 960px) 100vw, 1200px" loading="eager"/><div class="veil"></div><div class="hero-copy">{eyebrow&&<span class="eyebrow">{eyebrow}</span>}<h1>{title}</h1><p>{description}</p></div>{count&&<span class="count">{count}</span>}</section>
<style>.section-hero{position:relative;min-height:12rem;overflow:hidden;padding:2rem;display:flex;align-items:center}.section-hero :global(img){position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.veil{position:absolute;inset:0;background:linear-gradient(90deg,color-mix(in srgb,var(--surface) 98%,transparent) 0%,color-mix(in srgb,var(--surface) 86%,transparent) 38%,rgba(255,255,255,.05) 78%)}.hero-copy{position:relative;z-index:1;max-width:43rem}.hero-copy h1{font-size:clamp(2rem,4vw,3.3rem);line-height:1.1;margin:.25rem 0}.hero-copy p{max-width:35rem;margin:.5rem 0 0;color:var(--muted);font-weight:600}.count{position:absolute;z-index:2;right:1.2rem;bottom:1rem;color:var(--muted);font-size:.85rem}@media(max-width:640px){.section-hero{min-height:15rem;padding:1.25rem}.veil{background:color-mix(in srgb,var(--surface) 83%,transparent)}.hero-copy p{font-size:.9rem}}</style>
<style>.section-hero :global(picture){position:absolute;inset:0;width:100%;height:100%}</style>
