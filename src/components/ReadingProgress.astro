<div class="reading-bar" aria-hidden="true"></div>
<script>
  const key = 'aizhixing:reading:v1';
  const update = () => {
    const max = Math.max(1, document.documentElement.scrollHeight - innerHeight);
    const percent = Math.min(100, Math.max(0, scrollY / max * 100));
    document.querySelectorAll<HTMLElement>('[data-reading-track], .reading-bar').forEach((bar) => { bar.style.width = `${percent}%`; });
    document.querySelectorAll<HTMLElement>('[data-reading-label]').forEach((label) => { label.textContent = `${Math.round(percent)}%`; });
    try { const data = JSON.parse(localStorage.getItem(key) || '{}'); data[location.pathname] = Math.max(data[location.pathname] || 0, Math.round(percent)); localStorage.setItem(key, JSON.stringify(data)); } catch { /* Optional enhancement. */ }
  };
  addEventListener('scroll', update, { passive: true }); addEventListener('resize', update, { passive: true }); update();
</script>
