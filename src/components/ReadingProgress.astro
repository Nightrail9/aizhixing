<div class="reading-bar" aria-hidden="true"></div><script>const key='aizhixing:reading:v1';const bar=document.querySelector<HTMLElement>('.reading-bar');const update=()=>{const max=Math.max(1,document.documentElement.scrollHeight-innerHeight);const percent=Math.min(100,Math.max(0,scrollY/max*100));if(bar)bar.style.width=`${percent}%`;try{const data=JSON.parse(localStorage.getItem(key)||'{}');data[location.pathname]=Math.max(data[location.pathname]||0,Math.round(percent));localStorage.setItem(key,JSON.stringify(data))}catch{}};addEventListener('scroll',update,{passive:true});update();</script>
