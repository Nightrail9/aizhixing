---
import type { CollectionEntry } from 'astro:content';
import Picture from '../components/ResponsiveImage.astro';
import { ExternalLink } from 'lucide-astro';
import ContentLayout from './ContentLayout.astro';
import { formatDate } from '../lib/content';
import { imageFor } from '../lib/images';

interface Heading { depth: number; slug: string; text: string }
interface Props { entry: CollectionEntry<'resources'>; headings: Heading[] }
const { entry, headings } = Astro.props;
const kindLabel = { paper: '论文文献', project: '开源项目', tool: 'AI 工具' }[entry.data.kind];
const facts = entry.data.kind === 'paper'
  ? [['作者', entry.data.authors.join('、')], ['会议 / 来源', entry.data.venue]]
  : entry.data.kind === 'project'
    ? [['维护者', entry.data.owner], ['仓库', `${entry.data.owner}/${entry.data.repository}`], ['主要语言', entry.data.language], ['许可证', entry.data.license], ...(entry.data.stars ? [['Stars', entry.data.stars]] : [])]
    : [['开发者', entry.data.developer], ['平台', entry.data.platforms.join('、')], ['价格', entry.data.pricing]];
---
<ContentLayout title={entry.data.title} description={entry.data.description} publishedAt={formatDate(entry.data.publishedAt)} headings={headings} tags={entry.data.tags} contentType={kindLabel} category={kindLabel}>
  <Picture class="detail-cover" src={imageFor(entry.data.cover)} alt={entry.data.coverAlt} formats={['avif','webp']} widths={[720,1100]} sizes="(max-width:960px) 100vw, 900px"/>
  <dl class="resource-facts surface">{facts.map(([label,value])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl>
  <p><a class="btn btn-primary" href={entry.data.url} target="_blank" rel="noreferrer">访问官方页面 <ExternalLink size={17}/></a></p>
  <slot/>
</ContentLayout>
