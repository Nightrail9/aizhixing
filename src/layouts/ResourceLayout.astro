---
import type { CollectionEntry } from 'astro:content';
import {
  Bookmark,
  CalendarDays,
  ChevronLeft,
  Download,
  FileText,
  Github,
  Globe,
  Home,
  Sparkles,
} from 'lucide-astro';
import Picture from '../components/ResponsiveImage.astro';
import BaseLayout from './BaseLayout.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import ShareButton from '../components/ShareButton.astro';
import Giscus from '../components/Giscus.astro';
import { formatDate } from '../lib/content';
import { imageFor } from '../lib/images';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  entry: CollectionEntry<'resources'>;
  headings: Heading[];
}

const { entry, headings } = Astro.props;
const base = import.meta.env.BASE_URL;
const kindLabel = { paper: '论文文献', project: '开源项目', tool: 'AI 工具' }[entry.data.kind];
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);

const facts =
  entry.data.kind === 'paper'
    ? [
        ['作者', entry.data.authors.join('、')],
        ['发布日期', formatDate(entry.data.publishedAt)],
        ['会议 / 来源', entry.data.venue],
      ]
    : entry.data.kind === 'project'
      ? [
          ['维护者', entry.data.owner],
          ['仓库', `${entry.data.owner}/${entry.data.repository}`],
          ['主要语言', entry.data.language],
          ['许可证', entry.data.license],
          ...(entry.data.stars ? [['Stars', entry.data.stars]] : []),
        ]
      : [
          ['开发方', entry.data.developer],
          ['工具类型', 'AI 对话应用 / 效率工具'],
          ['支持平台', entry.data.platforms.join(' / ')],
          ['价格', entry.data.pricing],
          ['适用方向', '写作、编程、学习、问答'],
        ];

const primaryLabel = entry.data.kind === 'paper' ? '下载论文' : entry.data.kind === 'project' ? '访问仓库' : '访问官网';
const PrimaryIcon = entry.data.kind === 'project' ? Github : entry.data.kind === 'paper' ? Download : Globe;
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <ReadingProgress />
  <div class="container resource-detail-grid">
    <!-- Left Sidebar: Identity & Facts Card -->
    <aside class:list={['resource-identity', 'surface', `resource-${entry.data.kind}`]}>
      <a class="resource-back" href={`${base}resources/`}>
        <ChevronLeft size={16} />
        <span>返回资源列表</span>
      </a>

      <div class="identity-media">
        <Picture src={imageFor(entry.data.cover)} alt={entry.data.coverAlt} formats={['avif', 'webp']} widths={[280, 420]} sizes="280px" />
      </div>

      <h2>{entry.data.title}</h2>
      <p class="identity-desc">{entry.data.description}</p>

      <dl class="resource-facts">
        {facts.map(([label, value]) => (
          <div class="fact-row">
            <dt>{label}</dt>
            <dd>{value}</dd>
          </div>
        ))}
      </dl>

      <div class="identity-tags">
        <h3>关键词标签</h3>
        <div class="tag-row">
          {entry.data.tags.map((tag) => (
            <span class="pill">{tag}</span>
          ))}
        </div>
      </div>
    </aside>

    <!-- Main Content Area -->
    <article class="resource-main" data-pagefind-body>
      <span class="sr-only" data-pagefind-filter={`type:${kindLabel}`}>{kindLabel}</span>
      <span class="sr-only" data-pagefind-filter={`category:${kindLabel}`}>{kindLabel}</span>
      {entry.data.tags.map((tag) => (
        <span class="sr-only" data-pagefind-filter={`tag:${tag}`}>{tag}</span>
      ))}

      <nav class="breadcrumbs" aria-label="面包屑" data-pagefind-ignore>
        <a href={base}><Home size={14} />首页</a>
        <span>/</span>
        <a href={`${base}resources/`}>资源</a>
        <span>/</span>
        <span>{kindLabel}</span>
      </nav>

      <h1 data-pagefind-meta="title">{entry.data.title}</h1>
      <p class="resource-lead" data-pagefind-meta="description">{entry.data.description}</p>

      <!-- Meta and Action Buttons Bar -->
      <div class="author-meta-bar" data-pagefind-ignore>
        <div class="meta">
          <span><CalendarDays size={14} />{formatDate(entry.data.publishedAt)}</span>
          {entry.data.kind === 'paper' && (
            <>
              <span>·</span>
              <span>{entry.data.venue}</span>
            </>
          )}
          {entry.data.kind === 'project' && (
            <>
              <span>·</span>
              <span>{entry.data.language}</span>
              <span>·</span>
              <span>{entry.data.license}</span>
            </>
          )}
          {entry.data.kind === 'tool' && (
            <>
              <span>·</span>
              <span>{entry.data.developer}</span>
            </>
          )}
        </div>

        <div class="detail-actions">
          <a class="btn btn-primary btn-action" href={entry.data.url} target="_blank" rel="noreferrer">
            <PrimaryIcon size={16} />
            <span>{primaryLabel}</span>
          </a>
          {entry.data.kind === 'tool' && (
            <a class="btn btn-action" href={entry.data.url} target="_blank" rel="noreferrer">
              <Sparkles size={16} />
              <span>立即体验</span>
            </a>
          )}
          {entry.data.kind === 'project' && (
            <a class="btn btn-action" href={entry.data.url} target="_blank" rel="noreferrer">
              <FileText size={16} />
              <span>查看文档</span>
            </a>
          )}
          <button class="btn btn-action bookmark-btn" type="button" data-bookmark-btn aria-label="收藏资源">
            <Bookmark size={16} />
            <span>收藏</span>
          </button>
          <ShareButton />
        </div>
      </div>

      {toc.length > 0 && (
        <details class="mobile-toc surface" data-pagefind-ignore>
          <summary>本页目录</summary>
          <ol>
            {toc.map((heading) => (
              <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
            ))}
          </ol>
        </details>
      )}

      <!-- Markdown Prose Slot -->
      <div class="prose resource-prose">
        <slot />
      </div>

      <Giscus />
    </article>

    <!-- Right Sidebar: TOC -->
    <aside class="toc-panel" aria-label="本页目录">
      <h2>本页目录</h2>
      <ol class="toc-list">
        {toc.map((heading) => (
          <li style={`padding-left:${(heading.depth - 2) * 0.75}rem`}>
            <a href={`#${heading.slug}`} data-toc-link={heading.slug}>{heading.text}</a>
          </li>
        ))}
      </ol>
    </aside>
  </div>
</BaseLayout>

<script>
  // Bookmark button
  const bookmarkBtn = document.querySelector<HTMLButtonElement>('[data-bookmark-btn]');
  if (bookmarkBtn) {
    const pageId = window.location.pathname;
    const isSaved = localStorage.getItem(`aizhixing:bookmark:${pageId}`) === 'true';
    if (isSaved) {
      bookmarkBtn.classList.add('active');
      bookmarkBtn.querySelector('span')!.textContent = '已收藏';
    }
    bookmarkBtn.addEventListener('click', () => {
      const nowSaved = bookmarkBtn.classList.toggle('active');
      localStorage.setItem(`aizhixing:bookmark:${pageId}`, String(nowSaved));
      bookmarkBtn.querySelector('span')!.textContent = nowSaved ? '已收藏' : '收藏';
    });
  }

  // Active TOC spy
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute('id');
          document.querySelectorAll('[data-toc-link]').forEach((link) => {
            link.classList.toggle('active', link.getAttribute('data-toc-link') === id);
          });
        }
      });
    },
    { rootMargin: '-80px 0% -60% 0%' }
  );

  document.querySelectorAll('article h2[id], article h3[id]').forEach((heading) => {
    observer.observe(heading);
  });
</script>

<style>
  .resource-detail-grid {
    display: grid;
    grid-template-columns: 290px minmax(0, 1fr) 240px;
    gap: 1.75rem;
    align-items: start;
    padding-block: 1.5rem 3.5rem;
  }

  /* Left Sidebar Identity */
  .resource-identity {
    position: sticky;
    top: 5.6rem;
    overflow: hidden;
    padding: 1.25rem;
    border-radius: 1rem;
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
  }
  .resource-back {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    color: var(--muted);
    font-size: .84rem;
    font-weight: 600;
    margin-bottom: 1.15rem;
    transition: color .15s;
  }
  .resource-back:hover { color: var(--brand); }

  .identity-media {
    margin-bottom: 1rem;
  }
  .resource-identity :global(img) {
    display: block;
    width: 100%;
    object-fit: cover;
    border-radius: .75rem;
    border: 1px solid var(--line);
  }
  .resource-paper :global(img) { aspect-ratio: 4 / 5.2; }
  .resource-project :global(img), .resource-tool :global(img) {
    aspect-ratio: 1;
    max-width: 180px;
    margin: 0 auto;
  }

  .resource-identity h2 {
    margin: 0 0 .45rem;
    font-size: 1.15rem;
    font-weight: 750;
    line-height: 1.35;
    color: var(--text);
  }
  .identity-desc {
    margin: 0 0 1rem;
    color: var(--muted);
    font-size: .82rem;
    line-height: 1.55;
  }

  .resource-facts {
    display: flex;
    flex-direction: column;
    gap: .55rem;
    padding-block: .85rem;
    border-block: 1px solid var(--line);
    margin: 0 0 1rem;
  }
  .fact-row {
    display: grid;
    grid-template-columns: 5.2rem minmax(0, 1fr);
    gap: .5rem;
    font-size: .8rem;
  }
  .fact-row dt { color: var(--muted); }
  .fact-row dd {
    margin: 0;
    color: var(--text);
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .identity-tags h3 {
    margin: 0 0 .5rem;
    font-size: .85rem;
    font-weight: 700;
    color: var(--text);
  }

  /* Main */
  .resource-main { min-width: 0; }
  .resource-main h1 {
    margin: .35rem 0 .5rem;
    font-size: clamp(2rem, 3.2vw, 2.5rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -.03em;
    color: var(--text);
  }
  .resource-lead {
    margin: 0 0 .85rem;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.65;
  }

  .author-meta-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.15rem;
    border-bottom: 1px solid var(--line);
    margin-bottom: 1.5rem;
  }
  .detail-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .55rem;
  }
  .btn-action {
    min-height: 2.25rem;
    padding: .35rem .85rem;
    font-size: .82rem;
    border-radius: .55rem;
  }
  .bookmark-btn.active {
    color: var(--brand);
    background: var(--brand-soft);
    border-color: var(--brand-soft-border);
  }

  /* Custom styling for resource markdown content grids */
  .resource-prose :global(h2 + ul) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: .85rem;
    padding: 0;
    list-style: none;
    margin: 1.25rem 0;
  }
  .resource-prose :global(h2 + ul li) {
    min-height: 4.8rem;
    margin: 0;
    padding: .85rem 1rem;
    color: var(--text);
    border: 1px solid var(--line);
    border-radius: .75rem;
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    font-weight: 500;
    font-size: .88rem;
  }

  .resource-prose :global(h2 + ol) {
    counter-reset: steps;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: .85rem;
    padding: 0;
    list-style: none;
    margin: 1.25rem 0;
  }
  .resource-prose :global(h2 + ol li) {
    counter-increment: steps;
    position: relative;
    min-height: 4.5rem;
    margin: 0;
    padding: .85rem .85rem .85rem 3rem;
    border: 1px solid var(--line);
    border-radius: .75rem;
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    font-size: .86rem;
    font-weight: 500;
  }
  .resource-prose :global(h2 + ol li::before) {
    content: counter(steps);
    position: absolute;
    left: .85rem;
    top: .85rem;
    width: 1.6rem;
    height: 1.6rem;
    display: grid;
    place-items: center;
    border-radius: 999px;
    color: #fff;
    background: var(--brand);
    font-size: .75rem;
    font-weight: 800;
  }

  @media (max-width: 1180px) {
    .resource-detail-grid { grid-template-columns: 260px minmax(0, 1fr); }
    .resource-detail-grid > .toc-panel { display: none; }
  }
  @media (max-width: 820px) {
    .resource-detail-grid { grid-template-columns: 1fr; }
    .resource-identity {
      position: static;
      display: grid;
      grid-template-columns: 140px minmax(0, 1fr);
      gap: .5rem 1rem;
    }
    .resource-back { grid-column: 1 / -1; margin-bottom: .5rem; }
    .identity-media { grid-row: 2 / span 3; margin: 0; }
    .resource-facts, .identity-tags { grid-column: 1 / -1; }
  }
</style>
