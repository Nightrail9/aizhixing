---
import type { CollectionEntry } from 'astro:content';
import { CalendarDays, ExternalLink, FileText, Github, Home } from 'lucide-astro';
import Picture from '../components/ResponsiveImage.astro';
import BaseLayout from './BaseLayout.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import ShareButton from '../components/ShareButton.astro';
import Giscus from '../components/Giscus.astro';
import { formatDate } from '../lib/content';
import { imageFor } from '../lib/images';

interface Heading { depth: number; slug: string; text: string }
interface Props { entry: CollectionEntry<'resources'>; headings: Heading[] }
const { entry, headings } = Astro.props;
const base = import.meta.env.BASE_URL;
const kindLabel = { paper: '论文文献', project: '开源项目', tool: 'AI 工具' }[entry.data.kind];
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const facts = entry.data.kind === 'paper'
  ? [['作者', entry.data.authors.join('、')], ['发布日期', formatDate(entry.data.publishedAt)], ['会议 / 来源', entry.data.venue]]
  : entry.data.kind === 'project'
    ? [['维护者', entry.data.owner], ['仓库', `${entry.data.owner}/${entry.data.repository}`], ['主要语言', entry.data.language], ['许可证', entry.data.license], ...(entry.data.stars ? [['Stars', entry.data.stars]] : [])]
    : [['开发者', entry.data.developer], ['工具类型', 'AI 应用'], ['支持平台', entry.data.platforms.join(' / ')], ['价格', entry.data.pricing]];
const primaryLabel = entry.data.kind === 'paper' ? '阅读论文' : entry.data.kind === 'project' ? '访问仓库' : '访问官网';
const PrimaryIcon = entry.data.kind === 'project' ? Github : entry.data.kind === 'paper' ? FileText : ExternalLink;
---
<BaseLayout title={entry.data.title} description={entry.data.description}>
  <ReadingProgress />
  <div class="container resource-detail-grid">
    <aside class:list={['resource-identity', 'surface', `resource-${entry.data.kind}`]}>
      <a class="resource-back" href={`${base}resources/`}>← 返回资源列表</a>
      <Picture src={imageFor(entry.data.cover)} alt={entry.data.coverAlt} formats={['avif','webp']} widths={[280,420]} sizes="280px" />
      <h2>{entry.data.title}</h2><p>{entry.data.description}</p>
      <dl class="resource-facts">{facts.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl>
      <div class="identity-tags"><h3>关键词标签</h3><div class="tag-row">{entry.data.tags.map((tag) => <span class="pill">{tag}</span>)}</div></div>
    </aside>

    <article class="resource-main" data-pagefind-body>
      <span class="sr-only" data-pagefind-filter={`type:${kindLabel}`}>{kindLabel}</span><span class="sr-only" data-pagefind-filter={`category:${kindLabel}`}>{kindLabel}</span>{entry.data.tags.map((tag) => <span class="sr-only" data-pagefind-filter={`tag:${tag}`}>{tag}</span>)}
      <nav class="breadcrumbs" aria-label="面包屑" data-pagefind-ignore><a href={base}><Home size={13} />首页</a><span>/</span><a href={`${base}resources/`}>资源</a><span>/</span><span>{kindLabel}</span></nav>
      <span class="pill">{kindLabel}</span><h1 data-pagefind-meta="title">{entry.data.title}</h1><p class="resource-lead" data-pagefind-meta="description">{entry.data.description}</p>
      <div class="meta" data-pagefind-ignore><span><CalendarDays size={15} />{formatDate(entry.data.publishedAt)}</span>{entry.data.kind === 'project' && <><span>{entry.data.language}</span><span>{entry.data.license}</span></>}</div>
      <div class="detail-actions" data-pagefind-ignore><a class="btn btn-primary" href={entry.data.url} target="_blank" rel="noreferrer"><PrimaryIcon size={17} />{primaryLabel}</a><ShareButton /></div>
      {toc.length > 0 && <details class="mobile-toc surface" data-pagefind-ignore><summary>本页目录</summary><ol>{toc.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></details>}
      <div class="prose resource-prose"><slot /></div><Giscus />
    </article>

    <aside class="toc-panel" aria-label="本页目录"><div class="reading-widget"><header><span>阅读进度</span><strong data-reading-label>0%</strong></header><div><span data-reading-track></span></div></div><h2>本页目录</h2><ol>{toc.map((heading) => <li style={`padding-left:${(heading.depth - 2) * .75}rem`}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></aside>
  </div>
</BaseLayout>

<style>
  .resource-detail-grid { display: grid; grid-template-columns: 285px minmax(0, 1fr) 250px; gap: 1.5rem; align-items: start; padding-block: 1rem 3rem; }
  .resource-identity { position: sticky; top: 5.6rem; overflow: hidden; padding: .9rem; }
  .resource-back { display: block; margin: -.9rem -.9rem .9rem; padding: .58rem .8rem; color: var(--brand); background: var(--surface-soft); border-bottom: 1px solid var(--line); font-size: .76rem; font-weight: 750; }
  .resource-identity :global(picture) { margin: 0 auto .8rem; }
  .resource-identity :global(img) { display: block; width: 100%; object-fit: cover; border-radius: .55rem; }
  .resource-paper :global(img) { aspect-ratio: 4 / 5; }
  .resource-project :global(img), .resource-tool :global(img) { aspect-ratio: 1; }
  .resource-project :global(picture), .resource-tool :global(picture) { max-width: 170px; }
  .resource-identity h2 { margin: .55rem 0 .3rem; font-size: 1.12rem; line-height: 1.35; }
  .resource-identity > p { margin: 0; color: var(--muted); font-size: .76rem; }
  .identity-tags { padding-top: .8rem; border-top: 1px solid var(--line); }
  .identity-tags h3 { margin: 0 0 .55rem; font-size: .88rem; }
  .resource-main { min-width: 0; }
  .resource-main h1 { margin: .3rem 0; font-size: clamp(2rem, 3vw, 2.4rem); line-height: 1.15; letter-spacing: -.035em; }
  .resource-lead { margin: 0 0 .6rem; color: var(--muted); font-size: 1rem; }
  .resource-prose :global(h2 + ul) { display: grid; grid-template-columns: repeat(auto-fit, minmax(155px, 1fr)); gap: .55rem; padding: 0; list-style: none; }
  .resource-prose :global(h2 + ul li) { min-height: 4.5rem; margin: 0; padding: .7rem .8rem; color: var(--text); border: 1px solid var(--line); border-radius: .55rem; background: var(--surface-soft); }
  .resource-prose :global(h2 + ol) { counter-reset: steps; display: grid; grid-template-columns: repeat(auto-fit, minmax(145px, 1fr)); gap: .55rem; padding: 0; list-style: none; }
  .resource-prose :global(h2 + ol li) { counter-increment: steps; position: relative; min-height: 4.2rem; margin: 0; padding: .65rem .65rem .65rem 2.65rem; border: 1px solid var(--line); border-radius: .55rem; background: var(--surface-soft); }
  .resource-prose :global(h2 + ol li::before) { content: counter(steps); position: absolute; left: .65rem; top: .65rem; width: 1.4rem; height: 1.4rem; display: grid; place-items: center; border-radius: 99px; color: #fff; background: var(--brand); font-size: .7rem; font-weight: 800; }
  .breadcrumbs a { display: inline-flex; align-items: center; gap: .25rem; }
  @media (max-width: 1180px) { .resource-detail-grid { grid-template-columns: 250px minmax(0,1fr); } .resource-detail-grid > .toc-panel { display: none; } }
  @media (max-width: 820px) { .resource-detail-grid { grid-template-columns: 1fr; gap: .7rem; } .resource-identity { position: static; display: grid; grid-template-columns: 118px minmax(0,1fr); gap: .25rem .8rem; padding: .8rem; } .resource-back { grid-column: 1/-1; margin: -.8rem -.8rem .55rem; } .resource-identity :global(picture) { grid-row: 2 / span 4; margin: 0; } .resource-identity h2 { margin: 0; } .resource-identity > p { grid-column: 2; } .resource-facts, .identity-tags { grid-column: 1/-1; } }
  @media (max-width: 560px) { .resource-identity { grid-template-columns: 92px minmax(0,1fr); } .resource-prose :global(h2 + ul), .resource-prose :global(h2 + ol) { grid-template-columns: 1fr; } }
</style>
