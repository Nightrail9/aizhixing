---
import { CalendarDays, Clock3, Eye, Home, UserRound } from 'lucide-astro';
import BaseLayout from './BaseLayout.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import ShareButton from '../components/ShareButton.astro';
import Giscus from '../components/Giscus.astro';
interface Heading { depth: number; slug: string; text: string }
interface Props { title: string; description: string; publishedAt: string; headings: Heading[]; tags?: string[]; duration?: number; views?: number; showComments?: boolean; contentType?: string; category?: string }
const { title, description, publishedAt, headings, tags = [], duration, views, showComments = true, contentType = '文章', category } = Astro.props;
const base = import.meta.env.BASE_URL;
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---
<BaseLayout title={title} description={description}>
  <ReadingProgress />
  <div class="container detail-shell">
    <article class="detail-main" data-pagefind-body>
      <span class="sr-only" data-pagefind-filter={`type:${contentType}`}>{contentType}</span>{category && <span class="sr-only" data-pagefind-filter={`category:${category}`}>{category}</span>}
      <nav class="breadcrumbs" aria-label="面包屑" data-pagefind-ignore><a href={base}><Home size={13} />首页</a><span>/</span><a href={`${base}articles/`}>文章</a>{category && <><span>/</span><span>{category}</span></>}</nav>
      {category && <span class="pill">{category}</span>}
      <h1 data-pagefind-meta="title">{title}</h1><p class="detail-lead" data-pagefind-meta="description">{description}</p>
      <div class="meta" data-pagefind-ignore><span><UserRound size={15} />Nightrail9</span><span><CalendarDays size={15} />{publishedAt}</span>{duration && <span><Clock3 size={15} />约 {duration} 分钟阅读</span>}{views !== undefined && <span><Eye size={15} />{views.toLocaleString()} 阅读</span>}</div>
      <div class="tag-row detail-tags">{tags.map((tag) => <span class="pill" data-pagefind-filter={`tag:${tag}`}>{tag}</span>)}</div>
      <div class="detail-actions" data-pagefind-ignore><ShareButton /></div>
      {toc.length > 0 && <details class="mobile-toc surface" data-pagefind-ignore><summary>文章目录</summary><ol>{toc.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></details>}
      <div class="prose"><slot /></div>
      {showComments && <Giscus />}
    </article>
    <aside class="toc-panel" aria-label="文章目录">
      <div class="reading-widget"><header><span>阅读进度</span><strong data-reading-label>0%</strong></header><div><span data-reading-track></span></div></div>
      <h2>文章目录</h2><ol>{toc.map((heading) => <li style={`padding-left:${(heading.depth - 2) * .75}rem`}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol>
    </aside>
  </div>
</BaseLayout>
<style>.breadcrumbs a { display: inline-flex; align-items: center; gap: .25rem; }.detail-tags { margin-top: .65rem; }</style>
