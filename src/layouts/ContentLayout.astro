---
import BaseLayout from './BaseLayout.astro';import ReadingProgress from '../components/ReadingProgress.astro';import ShareButton from '../components/ShareButton.astro';import Giscus from '../components/Giscus.astro';import {CalendarDays,Clock3,UserRound} from 'lucide-astro';
interface Heading{depth:number;slug:string;text:string}interface Props{title:string;description:string;publishedAt:string;headings:Heading[];tags?:string[];duration?:number;showComments?:boolean;contentType?:string;category?:string}
const{title,description,publishedAt,headings,tags=[],duration,showComments=true,contentType='文章',category}=Astro.props;
---
<BaseLayout title={title} description={description}><ReadingProgress/><div class="container detail-grid" data-pagefind-body><article class="detail-main"><span class="sr-only" data-pagefind-filter={`type:${contentType}`}>{contentType}</span>{category&&<span class="sr-only" data-pagefind-filter={`category:${category}`}>{category}</span>}<div class="eyebrow">AI知行 · 深度阅读</div><h1 data-pagefind-meta="title">{title}</h1><p class="muted" data-pagefind-meta="description">{description}</p><div class="meta"><span><UserRound size={16}/> Nightrail9</span><span><CalendarDays size={16}/> {publishedAt}</span>{duration&&<span><Clock3 size={16}/> 约 {duration} 分钟</span>}</div><div class="tag-row">{tags.map((tag)=><span class="pill" data-pagefind-filter={`tag:${tag}`}>{tag}</span>)}</div><div style="margin-top:1rem"><ShareButton/></div><div class="prose"><slot/></div>{showComments&&<Giscus/>}</article><aside class="toc" aria-label="本页目录"><h2>本页目录</h2><ol>{headings.filter((h)=>h.depth===2||h.depth===3).map((heading)=><li style={`padding-left:${(heading.depth-2)*.8}rem`}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></aside></div></BaseLayout>
<style>.detail-main>.muted{font-size:1.08rem;margin:.4rem 0 1rem}.meta span{display:inline-flex;align-items:center;gap:.35rem}</style>
