---
import { Search } from 'lucide-astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="搜索" description="搜索 AI知行的文章、教程、论文、项目与工具。"><section class="search-page container"><div class="eyebrow">FULL-TEXT SEARCH</div><h1>搜索知识库</h1><p class="muted">在文章、教程与精选资源中查找关键词。</p><form class="search-form surface" role="search"><Search size={20}/><label class="sr-only" for="query">搜索关键词</label><input id="query" name="q" type="search" placeholder="例如：RAG、Python、注意力机制" autocomplete="off"/><label class="sr-only" for="type">内容类型</label><select id="type"><option value="">全部类型</option><option>文章</option><option>教程</option><option>论文文献</option><option>开源项目</option><option>AI 工具</option></select><button class="btn btn-primary" type="submit">搜索</button></form><p class="search-status muted" aria-live="polite" data-status>输入关键词开始搜索。</p><div class="search-results" data-results></div></section></BaseLayout>
<script is:inline define:vars={{base}}>
  const form=document.querySelector('.search-form');const input=document.querySelector('#query');const type=document.querySelector('#type');const status=document.querySelector('[data-status]');const results=document.querySelector('[data-results]');let engine;
  const escapeHtml=(value)=>String(value??'').replace(/[&<>'"]/g,(char)=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[char]));
  const run=async()=>{const query=input.value.trim();if(!query){status.textContent='输入关键词开始搜索。';results.replaceChildren();return}status.textContent='正在搜索…';try{engine??=await import(`${base}pagefind/pagefind.js`);await engine.options({baseUrl:base});const filters=type.value?{type:type.value}:undefined;const search=await engine.search(query,{filters});const rows=await Promise.all(search.results.slice(0,24).map((item)=>item.data()));status.textContent=`找到 ${search.results.length} 条结果`;results.innerHTML=rows.length?rows.map((row)=>`<article class="surface search-result"><div class="eyebrow">${escapeHtml(row.filters?.type?.[0]||'AI知行')}</div><h2><a href="${escapeHtml(row.url)}">${escapeHtml(row.meta?.title||row.url)}</a></h2><p>${row.excerpt||escapeHtml(row.meta?.description||'')}</p></article>`).join(''):'<div class="surface empty-state"><h2>没有匹配结果</h2><p>试试更短的关键词，或切换到全部类型。</p></div>'}catch(error){console.error(error);status.textContent='搜索索引尚未生成。请运行完整构建后再试。';results.replaceChildren()}};
  form?.addEventListener('submit',(event)=>{event.preventDefault();const url=new URL(location.href);url.searchParams.set('q',input.value.trim());history.replaceState({},'',url);run()});type?.addEventListener('change',run);const initial=new URL(location.href).searchParams.get('q')||'';input.value=initial;if(initial)run();
</script>
<style>.search-page{padding-block:clamp(2rem,6vw,5rem);max-width:920px}.search-page h1{margin:.25rem 0;font-size:clamp(2.2rem,5vw,4rem)}.search-form{display:grid;grid-template-columns:auto minmax(0,1fr) 170px auto;align-items:center;gap:.7rem;padding:.8rem 1rem;margin:1.5rem 0}.search-form input,.search-form select{min-width:0;border:0;background:transparent;color:var(--text);outline:0}.search-form select{padding:.45rem;border-left:1px solid var(--line)}.search-results{display:grid;gap:.8rem}.search-result{padding:1rem 1.2rem}.search-result h2{margin:.3rem 0;font-size:1.2rem}.search-result p{margin:0;color:var(--muted)}.search-result mark{background:#ffe480;color:#071746}.empty-state{padding:2rem;text-align:center}@media(max-width:680px){.search-form{grid-template-columns:auto 1fr}.search-form select,.search-form button{grid-column:1/-1;width:100%}.search-form select{border-left:0;border-top:1px solid var(--line)}}</style>
