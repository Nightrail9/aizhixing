---
import {getCollection} from 'astro:content';import BaseLayout from '../../layouts/BaseLayout.astro';import SectionHero from '../../components/SectionHero.astro';import ContentCard from '../../components/ContentCard.astro';import ListingFilters from '../../components/ListingFilters.astro';import {byDateDesc,formatDate,publicOnly,resourceHref} from '../../lib/content';import {imageFor} from '../../lib/images';
const base=import.meta.env.BASE_URL;const resources=(await getCollection('resources')).filter(publicOnly).sort(byDateDesc);const kinds=[{label:'论文文献',value:'paper'},{label:'开源项目',value:'project'},{label:'AI 工具',value:'tool'}];const items=kinds.map((item)=>({...item,count:resources.filter((r)=>r.data.kind===item.value).length}));const label={paper:'论文文献',project:'开源项目',tool:'AI 工具'};
---
<BaseLayout title="资源" description="精选 AI 论文、开源项目与实用工具。"><div class="container listing-layout"><ListingFilters title="资源分类" items={items}/><div class="listing-main"><SectionHero eyebrow="CURATED RESOURCES" title="资源" description="精选优质论文、开源项目和 AI 工具，帮助你构建可靠的知识体系和实践能力。" count={`共 ${resources.length} 条资源`}/><div class="toolbar surface"><span>按最新收录排序</span><span class="muted">重要信息请以官方网站为准</span></div><div class="card-grid listing-cards">{resources.map((entry)=><ContentCard href={resourceHref(entry,base)} title={entry.data.title} description={entry.data.description} image={imageFor(entry.data.cover)} alt={entry.data.coverAlt} date={formatDate(entry.data.publishedAt)} tags={[entry.data.kind,...entry.data.tags]} badge={label[entry.data.kind]}/>)}</div></div></div></BaseLayout>
