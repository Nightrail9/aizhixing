---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHero from '../../components/SectionHero.astro';
import ContentCard from '../../components/ContentCard.astro';
import ListingFilters from '../../components/ListingFilters.astro';
import { articleHref, byDateDesc, formatDate, publicOnly } from '../../lib/content';
import { imageFor } from '../../lib/images';

const base = import.meta.env.BASE_URL;
const articles = (await getCollection('articles')).filter(publicOnly).sort(byDateDesc);

const categories = [...new Set(articles.map((entry) => entry.data.category))].map((value) => ({
  label: value,
  value,
  count: articles.filter((entry) => entry.data.category === value).length,
}));

const tags = [...new Set(articles.flatMap((entry) => entry.data.tags))]
  .map((value) => ({
    label: value,
    value,
    count: articles.filter((entry) => entry.data.tags.includes(value)).length,
  }))
  .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label, 'zh-CN'));

const years = [...new Set(articles.map((entry) => String(entry.data.publishedAt.getFullYear())))]
  .sort((a, b) => Number(b) - Number(a))
  .map((value) => ({
    label: `${value} 年`,
    value,
    count: articles.filter((entry) => String(entry.data.publishedAt.getFullYear()) === value).length,
  }));

const groups = [
  { id: 'category' as const, title: '分类导航', allLabel: '全部文章', items: categories },
  { id: 'tag' as const, title: '标签', allLabel: '全部标签', items: tags },
  { id: 'year' as const, title: '年份归档', allLabel: '全部年份', items: years },
];
---

<BaseLayout title="文章" description="记录 AI 学习思考、技术解析与实践笔记。">
  <div class="container listing-shell">
    <ListingFilters groups={groups} />
    <div class="listing-main">
      <SectionHero
        title="文章"
        subtitle="记录 AI 学习思考、技术解析与实践笔记"
        description="从思考到实践，分享我在人工智能领域的探索历程、技术理解与实践经验，希望这些文字能帮助更多人一起看见 AI 带来的可能。"
        quote={'持续学习，\n让 AI 帮我们看见更大的世界。'}
      />

      <div class="listing-toolbar surface">
        <div class="sort-group">
          <span>排序：</span>
          <button class="sort-button" data-sort-mode="latest" aria-pressed="true">最新发布</button>
          <button class="sort-button" data-sort-mode="popular" aria-pressed="false">最多阅读</button>
        </div>
        <span class="listing-total">共 {articles.length} 篇文章</span>
      </div>

      <div class="listing-cards">
        {articles.map((entry) => (
          <ContentCard
            href={articleHref(entry, base)}
            title={entry.data.title}
            description={entry.data.description}
            image={imageFor(entry.data.cover)}
            alt={entry.data.coverAlt}
            date={formatDate(entry.data.publishedAt)}
            dateValue={entry.data.publishedAt.valueOf()}
            year={String(entry.data.publishedAt.getFullYear())}
            category={entry.data.category}
            views={entry.data.views ? `${entry.data.views.toLocaleString()} 阅读` : undefined}
            popularity={entry.data.views ?? 0}
            tags={entry.data.tags}
            badge={entry.data.featured ? '置顶推荐' : undefined}
            featured={entry.data.featured}
          />
        ))}
      </div>

      <div class="listing-empty surface" data-listing-empty hidden>
        <h2>没有匹配文章</h2>
        <p class="muted">请尝试清除或调整分类、标签与年份筛选条件。</p>
      </div>

      <nav class="listing-pagination" data-pagination hidden aria-label="分页">
        <button class="btn" data-page-prev>← 上一页</button>
        <div class="page-numbers">
          <span class="page-btn active">1</span>
        </div>
        <button class="btn" data-page-next>下一页 →</button>
      </nav>
    </div>
  </div>
</BaseLayout>
