---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';import SectionHero from '../../components/SectionHero.astro';import ContentCard from '../../components/ContentCard.astro';import ListingFilters from '../../components/ListingFilters.astro';
import {articleHref,byDateDesc,formatDate,publicOnly} from '../../lib/content';import {imageFor} from '../../lib/images';
const base=import.meta.env.BASE_URL;const articles=(await getCollection('articles')).filter(publicOnly).sort(byDateDesc);
const categories=['AI 思考','技术解析','学习方法','开发实践','工具推荐'];const items=categories.map((value)=>({label:value,value,count:articles.filter((a)=>a.data.category===value).length})).filter((item)=>item.count>0);
---
<BaseLayout title="文章" description="记录 AI 学习思考、技术解析与实践笔记。"><div class="container listing-layout"><ListingFilters title="分类导航" items={items}/><div class="listing-main"><SectionHero eyebrow="THOUGHTS & PRACTICE" title="文章" description="记录 AI 学习思考、技术解析与实践笔记，在持续写作中澄清问题、沉淀方法。" count={`共 ${articles.length} 篇文章`}/><div class="toolbar surface"><span>按最新发布排序</span><span class="muted">内容数量来自真实文章</span></div><div class="card-grid listing-cards">{articles.map((entry)=><ContentCard href={articleHref(entry,base)} title={entry.data.title} description={entry.data.description} image={imageFor(entry.data.cover)} alt={entry.data.coverAlt} date={formatDate(entry.data.publishedAt)} views={entry.data.views?.toLocaleString()} tags={[entry.data.category,...entry.data.tags]} badge={entry.data.featured?'置顶推荐':undefined}/>)}</div></div></div></BaseLayout>
