---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Picture from '../../components/ResponsiveImage.astro';
import ContentLayout from '../../layouts/ContentLayout.astro';
import { formatDate, publicOnly } from '../../lib/content';
import { imageFor } from '../../lib/images';
export async function getStaticPaths() { return (await getCollection('articles')).filter(publicOnly).map((entry) => ({ params: { slug: entry.id }, props: { entry } })); }
const { entry } = Astro.props as { entry: CollectionEntry<'articles'> };
const { Content, headings } = await render(entry);
const duration = Math.max(6, Math.round((entry.body?.length ?? entry.data.description.length) / 420));
---
<ContentLayout title={entry.data.title} description={entry.data.description} publishedAt={formatDate(entry.data.publishedAt)} headings={headings} tags={entry.data.tags} duration={duration} views={entry.data.views} contentType="文章" category={entry.data.category}>
  <Picture class="detail-cover" src={imageFor(entry.data.cover)} alt={entry.data.coverAlt} formats={['avif','webp']} widths={[720,1100,1500]} sizes="(max-width:1100px) 100vw, 1100px" />
  <Content />
</ContentLayout>
