---
import { getCollection } from 'astro:content';
import { ArrowRight, ChevronRight, FileText } from 'lucide-astro';
import Image from '../components/ResponsiveImage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { images, imageFor } from '../lib/images';
import { articleHref, byDateDesc, formatDate, publicOnly } from '../lib/content';

const base = import.meta.env.BASE_URL;
const articles = (await getCollection('articles')).filter(publicOnly).sort(byDateDesc);

const featured = articles.find((entry) => entry.data.featured) ?? articles[0];
const secondaryArticles = articles.filter((entry) => entry.id !== featured?.id).slice(0, 3);

// 4 Popular Courses for 2x2 Grid aligning with design preview
const popularCourses = [
  {
    id: 'python',
    title: 'Python 入门到进阶',
    description: '从基础语法到实际项目，打造扎实的编程基础。',
    count: '32 篇教程',
    href: `${base}tutorials/python-ai-practice/basics/1-1/`,
    icon: 'python',
  },
  {
    id: 'docker',
    title: 'Docker 实战教程',
    description: '从环境搭建到容器化部署，提升开发与部署效率。',
    count: '18 篇教程',
    href: `${base}tutorials/`,
    icon: 'docker',
  },
  {
    id: 'git',
    title: 'Git 版本控制',
    description: '掌握版本管理工具，让你的开发更规范高效。',
    count: '12 篇教程',
    href: `${base}tutorials/`,
    icon: 'git',
  },
  {
    id: 'transformer',
    title: 'Transformer 原理详解',
    description: '深入理解大模型核心原理，从理论到实践。',
    count: '24 篇教程',
    href: `${base}tutorials/langchain-practice/basics/1-1/`,
    icon: 'transformer',
  },
];

// Curated Papers
const defaultPapers = [
  {
    title: 'Attention Is All You Need',
    authors: 'Vaswani et al. · 2017',
    description: 'Transformer 的开创性工作，奠定了现代大模型的基础。',
    href: `${base}resources/papers/attention-is-all-you-need/`,
  },
  {
    title: 'Language Models are Few-Shot Learners',
    authors: 'Brown et al. · 2020',
    description: '展示了大语言模型的强大泛化能力，为后续研究提供了重要启发。',
    href: `${base}resources/papers/language-models-are-few-shot-learners/`,
  },
  {
    title: 'Visual Attention Is All You Need',
    authors: 'Dosovitskiy et al. · 2021',
    description: '提出 Vision Transformer (ViT)，将 Transformer 应用于计算机视觉领域。',
    href: `${base}resources/`,
  },
];

// Curated Open Source Projects
const defaultProjects = [
  {
    name: 'langchain',
    description: '用于构建基于大语言模型的应用开发框架。',
    href: `${base}resources/projects/langchain/`,
  },
  {
    name: 'open-webui',
    description: '功能强大的开源大模型 Web UI，支持本地部署。',
    href: `${base}resources/projects/open-webui/`,
  },
  {
    name: 'stable-diffusion-webui',
    description: '最受欢迎的文生图开源项目，丰富的插件生态。',
    href: `${base}resources/`,
  },
  {
    name: 'LlamaIndex',
    description: '一个用于构建大模型应用的数据框架。',
    href: `${base}resources/`,
  },
];
---

<BaseLayout>
  <!-- Hero Section -->
  <section class="home-hero">
    <Image src={images['hero-home']} alt="雪山湖畔的学习桌" widths={[760, 1200, 1920]} sizes="100vw" loading="eager" />
    <div class="hero-veil"></div>
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">AI LEARNING · A BRIGHTER YOU</p>
        <h1>与 <span>AI</span> 一起，<br />探索更大的可能</h1>
        <p>记录我在人工智能领域的学习思考、实践经验与优质资源，从入门到进阶，和你一起构建属于自己的技术世界。</p>
        <a class="btn btn-primary hero-btn" href={`${base}articles/`}>
          开始探索 <ArrowRight size={17} />
        </a>
      </div>
      <p class="hero-note">持续学习，<br />让 AI 帮我们看见更大的世界。</p>
    </div>
  </section>

  <!-- Content Grid -->
  <div class="container home-content">
    <!-- Left Column: 最新文章 -->
    <div class="home-col">
      <section class="home-card surface">
        <div class="section-head">
          <h2 class="section-title">最新文章</h2>
          <a class="text-link" href={`${base}articles/`}>查看更多 →</a>
        </div>
        <div class="latest-articles-grid">
          <!-- Featured Article -->
          {featured && (
            <article class="featured-article-card">
              <a class="featured-img-wrap" href={articleHref(featured, base)}>
                <Image src={imageFor(featured.data.cover)} alt={featured.data.coverAlt} widths={[480, 760]} sizes="(max-width: 768px) 100vw, 30vw" />
                <span class="pill featured-pill">{featured.data.category}</span>
              </a>
              <div class="featured-body">
                <h3><a href={articleHref(featured, base)}>{featured.data.title}</a></h3>
                <p>{featured.data.description}</p>
                <div class="featured-bottom">
                  <div class="meta">
                    <span>{formatDate(featured.data.publishedAt)}</span>
                    <span>·</span>
                    <span>{featured.data.views?.toLocaleString()} 阅读</span>
                    <span>·</span>
                    <span>12 分钟阅读</span>
                  </div>
                  <a class="round-arrow" href={articleHref(featured, base)} aria-label={`阅读 ${featured.data.title}`}>
                    <ArrowRight size={16} />
                  </a>
                </div>
              </div>
            </article>
          )}

          <!-- Secondary Articles List -->
          <div class="secondary-articles-list">
            {secondaryArticles.map((entry) => (
              <a class="story-item" href={articleHref(entry, base)}>
                <div class="story-thumb">
                  <Image src={imageFor(entry.data.cover)} alt={entry.data.coverAlt} width={130} />
                </div>
                <div class="story-content">
                  <h4>{entry.data.title}</h4>
                  <div class="meta">
                    <span>{formatDate(entry.data.publishedAt)}</span>
                    <span>·</span>
                    <span>{entry.data.views?.toLocaleString()} 阅读</span>
                  </div>
                </div>
                <ChevronRight size={18} class="story-chevron" />
              </a>
            ))}
          </div>
        </div>
      </section>

      <!-- 论文推荐 -->
      <section class="home-card surface mt-6">
        <div class="section-head">
          <h2 class="section-title">论文推荐</h2>
          <a class="text-link" href={`${base}resources/`}>查看更多 →</a>
        </div>
        <div class="paper-list">
          {defaultPapers.map((paper) => (
            <a class="paper-row" href={paper.href}>
              <div class="paper-icon-wrap">
                <FileText size={20} class="paper-icon" />
              </div>
              <div class="paper-info">
                <div class="paper-header">
                  <strong>{paper.title}</strong>
                  <span class="paper-authors">{paper.authors}</span>
                </div>
                <p class="paper-desc">{paper.description}</p>
              </div>
              <ChevronRight size={18} class="list-chevron" />
            </a>
          ))}
        </div>
      </section>
    </div>

    <!-- Right Column: 热门教程 & 开源项目推荐 -->
    <div class="home-col">
      <!-- 热门教程 (2x2 Grid) -->
      <section class="home-card surface">
        <div class="section-head">
          <h2 class="section-title">热门教程</h2>
          <a class="text-link" href={`${base}tutorials/`}>查看更多 →</a>
        </div>
        <div class="course-grid-2x2">
          {popularCourses.map((course) => (
            <a class="course-grid-card" href={course.href}>
              <div class="course-icon-wrap">
                {course.icon === 'python' && (
                  <svg class="tech-svg" viewBox="0 0 48 48" fill="none">
                    <path d="M23.6 4C14.7 4 15.2 7.8 15.2 7.8L15.3 11.8H24V13H11.2C5.9 13 4 16.7 4 21.9C4 28 8.4 28 8.4 28H11.8V23.7C11.8 18.8 16 18.6 16 18.6H24.3C28.5 18.6 28.7 14.8 28.7 14.8V7.9C28.7 7.9 29.5 4 23.6 4ZM19.2 7.7C20.1 7.7 20.8 8.4 20.8 9.3C20.8 10.2 20.1 10.9 19.2 10.9C18.3 10.9 17.6 10.2 17.6 9.3C17.6 8.4 18.3 7.7 19.2 7.7Z" fill="#387EB8"/>
                    <path d="M24.4 44C33.3 44 32.8 40.2 32.8 40.2L32.7 36.2H24V35H36.8C42.1 35 44 31.3 44 26.1C44 20 39.6 20 39.6 20H36.2V24.3C36.2 29.2 32 29.4 32 29.4H23.7C19.5 29.4 19.3 33.2 19.3 33.2V40.1C19.3 40.1 18.5 44 24.4 44ZM28.8 40.3C27.9 40.3 27.2 39.6 27.2 38.7C27.2 37.8 27.9 37.1 28.8 37.1C29.7 37.1 30.4 37.8 30.4 38.7C30.4 39.6 29.7 40.3 28.8 40.3Z" fill="#FFE052"/>
                  </svg>
                )}
                {course.icon === 'docker' && (
                  <svg class="tech-svg" viewBox="0 0 48 48" fill="none">
                    <path d="M43.7 20.2C42.6 19.4 40.1 19.4 38.9 19.8C38.3 17.4 36.8 15.3 34.6 14.1L33.4 13.4L32.4 14.3C30.7 15.8 29.6 18 29.4 20.4C26.9 20.5 24.3 21 21.9 22H5.6C4.8 22 4.1 22.5 3.9 23.3C2.4 29.8 6.4 36.6 13.9 38.5C21.6 40.4 32.1 39.8 38.7 34C43.1 30.1 45.4 24.1 44.8 20.9L44.6 20L43.7 20.2Z" fill="#0091E2"/>
                    <rect x="15" y="17" width="4" height="4" rx="0.5" fill="#0091E2"/>
                    <rect x="20" y="17" width="4" height="4" rx="0.5" fill="#0091E2"/>
                    <rect x="25" y="17" width="4" height="4" rx="0.5" fill="#0091E2"/>
                    <rect x="20" y="12" width="4" height="4" rx="0.5" fill="#0091E2"/>
                  </svg>
                )}
                {course.icon === 'git' && (
                  <svg class="tech-svg" viewBox="0 0 48 48" fill="none">
                    <rect x="24" y="4" width="28" height="28" rx="4" transform="rotate(45 24 4)" fill="#F05032"/>
                    <circle cx="24" cy="24" r="3.5" fill="#FFFFFF"/>
                    <circle cx="31" cy="17" r="3" fill="#FFFFFF"/>
                    <circle cx="17" cy="31" r="3" fill="#FFFFFF"/>
                    <line x1="17" y1="31" x2="31" y2="17" stroke="#FFFFFF" stroke-width="2.5"/>
                  </svg>
                )}
                {course.icon === 'transformer' && (
                  <svg class="tech-svg" viewBox="0 0 48 48" fill="none">
                    <path d="M24 4L40 13.2V31.6L24 40.8L8 31.6V13.2L24 4Z" fill="#7C3AED"/>
                    <path d="M24 4L40 13.2L24 22.4L8 13.2L24 4Z" fill="#8B5CF6"/>
                    <path d="M24 22.4V40.8L8 31.6V13.2L24 22.4Z" fill="#6D28D9"/>
                  </svg>
                )}
              </div>
              <h3>{course.title}</h3>
              <p>{course.description}</p>
              <strong class="course-link-text">{course.count} →</strong>
            </a>
          ))}
        </div>
      </section>

      <!-- 开源项目推荐 -->
      <section class="home-card surface mt-6">
        <div class="section-head">
          <h2 class="section-title">开源项目推荐</h2>
          <a class="text-link" href={`${base}resources/`}>查看更多 →</a>
        </div>
        <div class="project-list">
          {defaultProjects.map((project) => (
            <a class="project-row" href={project.href}>
              <div class="project-icon-wrap">
                <svg class="github-svg" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z" />
                </svg>
              </div>
              <div class="project-info">
                <strong>{project.name}</strong>
                <p class="project-desc">{project.description}</p>
              </div>
              <ChevronRight size={18} class="list-chevron" />
            </a>
          ))}
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  /* Hero Banner */
  .home-hero {
    position: relative;
    height: 24.5rem;
    overflow: hidden;
  }
  .home-hero > :global(picture), .home-hero > :global(picture img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .home-hero > :global(picture img) {
    object-fit: cover;
    object-position: center right;
  }
  .hero-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg,
      rgba(248, 252, 255, 0.98) 0%,
      rgba(248, 252, 255, 0.88) 36%,
      rgba(248, 252, 255, 0.1) 70%
    );
  }
  .dark .hero-veil {
    background: linear-gradient(90deg,
      rgba(9, 13, 22, 0.98) 0%,
      rgba(9, 13, 22, 0.88) 38%,
      rgba(9, 13, 22, 0.12) 72%
    );
  }
  .hero-inner {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .hero-copy {
    max-width: 36rem;
  }
  .hero-copy h1 {
    margin: .35rem 0 .75rem;
    font-size: clamp(2.6rem, 4.5vw, 3.8rem);
    font-weight: 850;
    line-height: 1.08;
    letter-spacing: -.04em;
    color: var(--text);
  }
  .hero-copy h1 span {
    color: var(--brand);
  }
  .hero-copy > p:not(.eyebrow) {
    max-width: 32rem;
    margin: 0;
    color: var(--muted);
    font-size: .95rem;
    line-height: 1.7;
  }
  .hero-btn {
    margin-top: 1.25rem;
    min-width: 9rem;
    height: 2.75rem;
    font-size: .95rem;
    border-radius: .75rem;
  }
  .hero-note {
    align-self: flex-start;
    margin: 3.2rem 8% 0 0;
    color: #0b59d8;
    font-family: 'KaiTi', 'STKaiti', cursive;
    font-size: 1.25rem;
    line-height: 1.75;
    transform: rotate(-6deg);
    text-shadow: 0 1px 2px rgba(255, 255, 255, 0.9);
  }
  .dark .hero-note {
    color: #60a5fa;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.9);
  }

  /* Home Content Layout */
  .home-content {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(360px, 1fr);
    gap: 1.5rem;
    padding-block: 1.5rem 3.5rem;
  }
  .home-col {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .home-card {
    padding: 1.5rem;
    border-radius: 1rem;
    border: 1px solid var(--line);
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  /* Latest Articles Section */
  .latest-articles-grid {
    display: grid;
    grid-template-columns: 1.08fr 0.92fr;
    gap: 1.25rem;
  }
  .featured-article-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: .85rem;
    overflow: hidden;
    background: var(--surface);
    transition: transform .2s ease, box-shadow .2s ease;
  }
  .featured-article-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }
  .featured-img-wrap {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }
  .featured-img-wrap :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .featured-pill {
    position: absolute;
    left: .75rem;
    top: .75rem;
    z-index: 2;
    background: rgba(37, 99, 235, 0.92);
    color: #fff;
    font-size: .72rem;
    padding: .2rem .6rem;
    border-radius: .4rem;
  }
  .featured-body {
    padding: 1.15rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .featured-body h3 {
    margin: 0 0 .5rem;
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.4;
  }
  .featured-body h3 a {
    color: var(--text);
    transition: color .15s;
  }
  .featured-body h3 a:hover { color: var(--brand); }
  .featured-body p {
    margin: 0 0 .75rem;
    color: var(--muted);
    font-size: .84rem;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .featured-bottom {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .5rem;
    padding-top: .75rem;
    border-top: 1px solid var(--line);
  }
  .round-arrow {
    width: 1.85rem;
    height: 1.85rem;
    border-radius: 999px;
    background: var(--brand-soft);
    color: var(--brand);
    display: grid;
    place-items: center;
    flex-shrink: 0;
    transition: all .15s;
  }
  .round-arrow:hover {
    background: var(--brand);
    color: #fff;
  }

  /* Secondary Articles */
  .secondary-articles-list {
    display: flex;
    flex-direction: column;
    gap: .65rem;
  }
  .story-item {
    display: grid;
    grid-template-columns: 105px minmax(0, 1fr) auto;
    align-items: center;
    gap: .85rem;
    padding: .5rem;
    border: 1px solid var(--line);
    border-radius: .75rem;
    background: var(--surface);
    transition: all .15s ease;
  }
  .story-item:hover {
    border-color: var(--brand-soft-border);
    transform: translateX(2px);
  }
  .story-thumb {
    width: 105px;
    height: 68px;
    border-radius: .5rem;
    overflow: hidden;
    flex-shrink: 0;
  }
  .story-thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .story-content h4 {
    margin: 0 0 .3rem;
    font-size: .86rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--text);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .story-chevron {
    color: var(--muted);
    transition: color .15s, transform .15s;
    flex-shrink: 0;
  }
  .story-item:hover .story-chevron {
    color: var(--brand);
    transform: translateX(2px);
  }

  /* 热门教程 2x2 网格 */
  .course-grid-2x2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: .85rem;
  }
  .course-grid-card {
    display: flex;
    flex-direction: column;
    padding: 1.15rem;
    border: 1px solid var(--line);
    border-radius: .85rem;
    background: var(--surface);
    transition: all .18s ease;
  }
  .course-grid-card:hover {
    border-color: var(--brand-soft-border);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }
  .course-icon-wrap {
    width: 2.5rem;
    height: 2.5rem;
    margin-bottom: .75rem;
    display: flex;
    align-items: center;
  }
  .tech-svg {
    width: 2.4rem;
    height: 2.4rem;
  }
  .course-grid-card h3 {
    margin: 0 0 .4rem;
    font-size: .95rem;
    font-weight: 750;
    color: var(--text);
  }
  .course-grid-card p {
    margin: 0 0 .85rem;
    color: var(--muted);
    font-size: .78rem;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .course-link-text {
    margin-top: auto;
    color: var(--brand);
    font-size: .8rem;
    font-weight: 600;
  }

  /* 论文推荐 */
  .paper-list, .project-list {
    display: flex;
    flex-direction: column;
  }
  .paper-row, .project-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: .95rem;
    padding: .75rem .25rem;
    border-top: 1px solid var(--line);
    transition: background-color .15s ease;
  }
  .paper-row:first-child, .project-row:first-child {
    border-top: none;
    padding-top: .25rem;
  }
  .paper-icon-wrap, .project-icon-wrap {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: .5rem;
    background: var(--surface-soft);
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }
  .paper-icon { color: var(--muted); }
  .github-svg {
    width: 1.35rem;
    height: 1.35rem;
    color: var(--text);
  }
