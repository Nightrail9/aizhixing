---
import {getCollection} from 'astro:content';import BaseLayout from '../../layouts/BaseLayout.astro';import SectionHero from '../../components/SectionHero.astro';import ContentCard from '../../components/ContentCard.astro';import ListingFilters from '../../components/ListingFilters.astro';import {byDateDesc,formatDate,publicOnly} from '../../lib/content';import {imageFor} from '../../lib/images';
const base=import.meta.env.BASE_URL;const courses=(await getCollection('courses')).filter(publicOnly).sort(byDateDesc);const lessons=(await getCollection('lessons')).filter(publicOnly);const cats=['基础开发','模型原理','Prompt 工程','RAG','Agent 应用','工程部署'];const items=cats.map((value)=>({label:value,value,count:courses.filter((c)=>c.data.category===value).length})).filter((x)=>x.count);
---
<BaseLayout title="教程" description="系统整理 AI 学习路径与实战课程。"><div class="container listing-layout"><ListingFilters title="课程分类" items={items}/><div class="listing-main"><SectionHero eyebrow="GUIDED LEARNING" title="教程" description="系统整理 AI 学习路径与实战课程，从基础知识到项目落地，按章节稳步前进。" count={`共 ${courses.length} 门课程 · ${lessons.length} 节`}/><div class="toolbar surface"><span>推荐学习路径</span><span class="muted">进度仅保存在当前浏览器</span></div><div class="card-grid listing-cards">{courses.map((entry)=><ContentCard href={`${base}tutorials/${entry.id}/basics/1-1/`} title={entry.data.title} description={entry.data.description} image={imageFor(entry.data.cover)} alt={entry.data.coverAlt} date={formatDate(entry.data.publishedAt)} tags={[entry.data.category,...entry.data.tags]} badge={`${entry.data.level} · ${lessons.filter((l)=>l.data.course===entry.id).length} 节`}/>)}</div></div></div></BaseLayout>
