---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHero from '../../components/SectionHero.astro';
import ContentCard from '../../components/ContentCard.astro';
import ListingFilters from '../../components/ListingFilters.astro';
import { byDateDesc, formatDate, publicOnly } from '../../lib/content';
import { imageFor } from '../../lib/images';

const base = import.meta.env.BASE_URL;
const courses = (await getCollection('courses')).filter(publicOnly).sort(byDateDesc);
const lessons = (await getCollection('lessons')).filter(publicOnly);

const categories = [...new Set(courses.map((entry) => entry.data.category))].map((value) => ({
  label: value,
  value,
  count: courses.filter((entry) => entry.data.category === value).length,
}));

const tags = [...new Set(courses.flatMap((entry) => entry.data.tags))]
  .map((value) => ({
    label: value,
    value,
    count: courses.filter((entry) => entry.data.tags.includes(value)).length,
  }))
  .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label, 'zh-CN'));

const years = [...new Set(courses.map((entry) => String(entry.data.publishedAt.getFullYear())))]
  .sort((a, b) => Number(b) - Number(a))
  .map((value) => ({
    label: `${value} 年`,
    value,
    count: courses.filter((entry) => String(entry.data.publishedAt.getFullYear()) === value).length,
  }));

const groups = [
  { id: 'category' as const, title: '分类导航', allLabel: '全部教程', items: categories },
  { id: 'tag' as const, title: '标签', allLabel: '全部标签', items: tags },
  { id: 'year' as const, title: '年份归档', allLabel: '全部年份', items: years },
];
---

<BaseLayout title="教程" description="系统整理 AI 学习路径与实战课程。">
  <div class="container listing-shell">
    <ListingFilters groups={groups} />
    <div class="listing-main">
      <SectionHero
        title="教程"
        subtitle="系统整理 AI 学习路径与实战课程"
        description="从基础知识到前沿技术，精心设计的教程体系，帮助你循序渐进掌握 AI 时代的核心技能，在实践中成长为更强大的自己。"
        quote={'持续学习，\n让 AI 帮我们看见更大的世界。'}
      />

      <div class="listing-toolbar surface">
        <div class="sort-group">
          <span>排序：</span>
          <button class="sort-button" data-sort-mode="latest" aria-pressed="true">最新发布</button>
          <button class="sort-button" data-sort-mode="popular" aria-pressed="false">最多人学</button>
        </div>
        <span class="listing-total">共 {courses.length} 门课程 · {lessons.length} 节</span>
      </div>

      <div class="listing-cards">
        {courses.map((entry) => {
          const count = lessons.filter((lesson) => lesson.data.course === entry.id).length;
          return (
            <ContentCard
              href={`${base}tutorials/${entry.id}/basics/1-1/`}
              title={entry.data.title}
              description={entry.data.description}
              image={imageFor(entry.data.cover)}
              alt={entry.data.coverAlt}
              date={formatDate(entry.data.publishedAt)}
              dateValue={entry.data.publishedAt.valueOf()}
              year={String(entry.data.publishedAt.getFullYear())}
              category={entry.data.category}
              popularity={entry.data.featured ? 100 : 50}
              tags={entry.data.tags}
              badge={entry.data.featured ? '精选推荐' : undefined}
              featured={entry.data.featured}
              extraMeta={`${count} 章节`}
            />
          );
        })}
      </div>

      <div class="listing-empty surface" data-listing-empty hidden>
        <h2>没有匹配课程</h2>
        <p class="muted">请调整分类、标签或年份筛选。</p>
      </div>

      <nav class="listing-pagination" data-pagination hidden aria-label="分页">
        <button class="btn" data-page-prev>← 上一页</button>
        <div class="page-numbers">
          <span class="page-btn active">1</span>
        </div>
        <button class="btn" data-page-next>下一页 →</button>
      </nav>
    </div>
  </div>
</BaseLayout>
