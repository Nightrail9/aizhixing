---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import {
  Bookmark,
  CalendarDays,
  CheckCircle2,
  ChevronLeft,
  ChevronRight,
  Clock3,
  Eye,
  Folder,
  FolderOpen,
  Home,
} from 'lucide-astro';
import Picture from '../../../../components/ResponsiveImage.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Giscus from '../../../../components/Giscus.astro';
import ReadingProgress from '../../../../components/ReadingProgress.astro';
import ShareButton from '../../../../components/ShareButton.astro';
import { lessonHref, formatDate, publicOnly } from '../../../../lib/content';
import { imageFor } from '../../../../lib/images';

export async function getStaticPaths() {
  return (await getCollection('lessons'))
    .filter(publicOnly)
    .map((entry) => ({
      params: {
        course: entry.data.course,
        module: entry.data.module,
        lesson: entry.id.split('/').at(-1),
      },
      props: { entry },
    }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'lessons'> };
const allLessons = (await getCollection('lessons'))
  .filter(publicOnly)
  .filter((lesson) => lesson.data.course === entry.data.course)
  .sort((a, b) => a.data.order - b.data.order);

const course = (await getCollection('courses')).find((item) => item.id === entry.data.course);
if (!course) throw new Error(`Course not found: ${entry.data.course}`);

const currentIndex = allLessons.findIndex((lesson) => lesson.id === entry.id);
const previous = allLessons[currentIndex - 1];
const next = allLessons[currentIndex + 1];

const modules = [...new Set(allLessons.map((lesson) => lesson.data.module))].map((module) => ({
  id: module,
  title: allLessons.find((lesson) => lesson.data.module === module)?.data.moduleTitle ?? module,
  lessons: allLessons.filter((lesson) => lesson.data.module === module),
}));

const { Content, headings } = await render(entry);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const base = import.meta.env.BASE_URL;
const progressKey = 'aizhixing:tutorial-progress:v1';
---

<BaseLayout title={`${entry.data.title} · ${course.data.title}`} description={entry.data.description}>
  <ReadingProgress />
  <div class="container lesson-grid">
    <!-- Left Sidebar: Course Tree & Progress -->
    <aside class="course-sidebar surface" aria-label="课程章节">
      <a class="course-back" href={`${base}tutorials/`}>
        <ChevronLeft size={16} />
        <span>返回教程列表</span>
      </a>

      <div class="course-header-box">
        <div class="course-logo-wrap">
          <Picture src={imageFor(course.data.cover)} alt={course.data.coverAlt} formats={['avif', 'webp']} widths={[160, 240]} sizes="120px" />
        </div>
        <div class="course-info">
          <h2>{course.data.title}</h2>
          <p>{course.data.description}</p>
        </div>
      </div>

      <!-- Course Progress Bar -->
      <div class="course-progress-card">
        <div class="progress-labels">
          <span class="progress-count">
            已完成 <strong data-progress-label>0</strong> / {allLessons.length} 章节
          </span>
          <span class="progress-percent" data-progress-percent>0%</span>
        </div>
        <div class="progress-track">
          <span data-progress-bar></span>
        </div>
      </div>

      <!-- Module & Lesson Tree -->
      <div class="course-tree">
        {modules.map((group, index) => {
          const isCurrentModule = group.lessons.some((l) => l.id === entry.id);
          return (
            <details class="module-group" open={isCurrentModule}>
              <summary class="module-title">
                {isCurrentModule ? <FolderOpen size={16} class="folder-icon" /> : <Folder size={16} class="folder-icon" />}
                <span>{index + 1}. {group.title}</span>
              </summary>
              <ol class="module-lessons">
                {group.lessons.map((lesson) => (
                  <li>
                    <a
                      class:list={['lesson-link', { active: lesson.id === entry.id }]}
                      href={lessonHref(lesson, base)}
                      data-lesson-link={lesson.id}
                    >
                      <span class="lesson-bullet" data-check>○</span>
                      <span class="lesson-name">{lesson.data.title}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </details>
          );
        })}
      </div>
    </aside>

    <!-- Main Content Area -->
    <article class="lesson-main" data-pagefind-body>
      <span class="sr-only" data-pagefind-filter="type:教程">教程</span>
      <span class="sr-only" data-pagefind-filter={`category:${course.data.category}`}>{course.data.category}</span>

      <nav class="breadcrumbs" aria-label="面包屑" data-pagefind-ignore>
        <a href={base}><Home size={14} />首页</a>
        <span>/</span>
        <a href={`${base}tutorials/`}>教程</a>
        <span>/</span>
        <a href={`${base}tutorials/${course.id}/basics/1-1/`}>{course.data.title}</a>
        <span>/</span>
        <span>{entry.data.moduleTitle}</span>
      </nav>

      <h1 data-pagefind-meta="title">{entry.data.title}</h1>
      <p class="lesson-lead" data-pagefind-meta="description">{entry.data.description}</p>

      <!-- Meta and Actions Bar -->
      <div class="author-meta-bar" data-pagefind-ignore>
        <div class="meta">
          <span><CalendarDays size={14} />{formatDate(entry.data.publishedAt)}</span>
          <span>·</span>
          <span><Clock3 size={14} />约 {entry.data.duration} 分钟阅读</span>
          <span>·</span>
          <span><Eye size={14} />2.1k 阅读</span>
          <span class="tag-row ml-2">
            {entry.data.tags.map((tag) => (
              <span class="pill" data-pagefind-filter={`tag:${tag}`}>{tag}</span>
            ))}
          </span>
        </div>

        <div class="detail-actions">
          <button class="btn btn-action bookmark-btn" type="button" data-bookmark-btn aria-label="收藏课程">
            <Bookmark size={16} />
            <span>收藏</span>
          </button>
          <ShareButton />
          <button class="btn btn-primary btn-action" type="button" data-complete>
            <CheckCircle2 size={16} />
            <span>完成本节</span>
          </button>
        </div>
      </div>

      <!-- Mobile Course Directory and Progress -->
      <details class="mobile-course surface" data-pagefind-ignore>
        <summary>课程目录与进度 <strong data-progress-label>0</strong> / {allLessons.length}</summary>
        <div class="progress-track mt-2">
          <span data-progress-bar></span>
        </div>
        <div class="course-tree mt-3">
          {modules.map((group, index) => (
            <div class="mb-3">
              <strong class="text-sm block mb-1">{index + 1}. {group.title}</strong>
              <ol class="space-y-1">
                {group.lessons.map((lesson) => (
                  <li>
                    <a
                      class:list={['lesson-link', { active: lesson.id === entry.id }]}
                      href={lessonHref(lesson, base)}
                      data-lesson-link={lesson.id}
                    >
                      <span data-check>○</span>
                      <span>{lesson.data.title}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </div>
          ))}
        </div>
      </details>

      {toc.length > 0 && (
        <details class="mobile-toc surface" data-pagefind-ignore>
          <summary>本节目录</summary>
          <ol>
            {toc.map((heading) => (
              <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
            ))}
          </ol>
        </details>
      )}

      <!-- Wide Cover Header Image -->
      <Picture
        class="lesson-cover"
        src={imageFor(course.data.cover)}
        alt={course.data.coverAlt}
        formats={['avif', 'webp']}
        widths={[720, 1100]}
        sizes="(max-width:1180px) 100vw, 880px"
      />

      <!-- Content -->
      <div class="prose">
        <Content />
      </div>

      <!-- Prev / Next Lesson Navigation -->
      <nav class="lesson-pagination" aria-label="上下节导航" data-pagefind-ignore>
        {previous ? (
          <a class="surface pagination-card prev" href={lessonHref(previous, base)}>
            <span class="pagination-sub"><ChevronLeft size={15} /> 上一节</span>
            <span class="pagination-title">{previous.data.title}</span>
          </a>
        ) : (
          <div />
        )}
        {next ? (
          <a class="surface pagination-card next" href={lessonHref(next, base)} data-next>
            <span class="pagination-sub">下一节 <ChevronRight size={15} /></span>
            <span class="pagination-title">{next.data.title}</span>
          </a>
        ) : (
          <a class="surface pagination-card next" href={`${base}tutorials/`} data-next>
            <span class="pagination-sub">课程完成 <ChevronRight size={15} /></span>
            <span class="pagination-title">返回教程列表</span>
          </a>
        )}
      </nav>

      <Giscus />
    </article>

    <!-- Right Sidebar: Lesson TOC -->
    <aside class="toc-panel" aria-label="本章目录">
      <h2>本章目录</h2>
      <ol class="toc-list">
        {toc.map((heading) => (
          <li style={`padding-left:${(heading.depth - 2) * 0.75}rem`}>
            <a href={`#${heading.slug}`} data-toc-link={heading.slug}>{heading.text}</a>
          </li>
        ))}
      </ol>
    </aside>
  </div>
</BaseLayout>

<script is:inline define:vars={{ progressKey, courseId: entry.data.course, lessonId: entry.id, total: allLessons.length }}>
  (() => {
    let all = {};
    try {
      all = JSON.parse(localStorage.getItem(progressKey) || '{}');
    } catch {
      all = {};
    }
    const completed = new Set(Array.isArray(all[courseId]) ? all[courseId] : []);

    const render = () => {
      document.querySelectorAll('[data-lesson-link]').forEach((link) => {
        const done = completed.has(link.getAttribute('data-lesson-link'));
        const check = link.querySelector('[data-check]');
        if (check) {
          check.textContent = done ? '✓' : '○';
          check.style.color = done ? 'var(--brand)' : 'var(--muted)';
          check.style.fontWeight = done ? 'bold' : 'normal';
        }
      });
      const percent = Math.round(Math.min(100, (completed.size / total) * 100));
      document.querySelectorAll('[data-progress-label]').forEach((label) => {
        label.textContent = `${completed.size}`;
      });
      document.querySelectorAll('[data-progress-percent]').forEach((p) => {
        p.textContent = `${percent}%`;
      });
      document.querySelectorAll('[data-progress-bar]').forEach((bar) => {
        bar.style.width = `${percent}%`;
      });
      const button = document.querySelector('[data-complete]');
      if (button) {
        const done = completed.has(lessonId);
        button.classList.toggle('is-done', done);
        const text = button.querySelector('span');
        if (text) text.textContent = done ? '已完成' : '完成本节';
      }
    };

    const save = () => {
      all[courseId] = [...completed];
      localStorage.setItem(progressKey, JSON.stringify(all));
      render();
    };

    document.querySelector('[data-complete]')?.addEventListener('click', () => {
      completed.add(lessonId);
      save();
    });

    document.querySelectorAll('[data-next]').forEach((link) =>
      link.addEventListener('click', () => {
        completed.add(lessonId);
        all[courseId] = [...completed];
        localStorage.setItem(progressKey, JSON.stringify(all));
      })
    );

    render();
  })();
</script>

<style>
  .lesson-grid {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr) 240px;
    gap: 1.75rem;
    align-items: start;
    padding-block: 1.5rem 3.5rem;
  }

  /* Course Sidebar */
  .course-sidebar {
    position: sticky;
    top: 5.6rem;
    max-height: calc(100vh - 6.5rem);
    overflow-y: auto;
    padding: 1.25rem;
    border-radius: 1rem;
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
  }
  .course-back {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    color: var(--muted);
    font-size: .84rem;
    font-weight: 600;
    margin-bottom: 1.15rem;
    transition: color .15s;
  }
  .course-back:hover { color: var(--brand); }

  .course-header-box {
    margin-bottom: 1.25rem;
  }
  .course-logo-wrap {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: .75rem;
    overflow: hidden;
    margin-bottom: .85rem;
    border: 1px solid var(--line);
  }
  .course-logo-wrap :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .course-info h2 {
    margin: 0 0 .35rem;
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--text);
  }
  .course-info p {
    margin: 0;
    color: var(--muted);
    font-size: .8rem;
    line-height: 1.5;
  }

  /* Progress Card */
  .course-progress-card {
    padding: .85rem;
    border-radius: .75rem;
    background: var(--surface-soft);
    margin-bottom: 1.25rem;
    border: 1px solid var(--line);
  }
  .progress-labels {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: .45rem;
    font-size: .78rem;
  }
  .progress-count { color: var(--muted); }
  .progress-count strong { color: var(--brand); font-weight: 700; }
  .progress-percent { color: var(--brand); font-weight: 700; }
  .progress-track {
    height: 6px;
    overflow: hidden;
    border-radius: 999px;
    background: var(--line);
  }
  .progress-track span {
    display: block;
    width: 0;
    height: 100%;
    border-radius: 999px;
    background: linear-gradient(90deg, #2563eb, #38bdf8);
    transition: width .2s ease;
  }

  /* Tree */
  .course-tree {
    display: flex;
    flex-direction: column;
    gap: .65rem;
  }
  .module-group summary {
    list-style: none;
    cursor: pointer;
  }
  .module-group summary::-webkit-details-marker { display: none; }
  .module-title {
    display: flex;
    align-items: center;
    gap: .5rem;
    padding: .45rem .5rem;
    border-radius: .5rem;
    font-size: .84rem;
    font-weight: 700;
    color: var(--text);
    transition: background-color .15s;
  }
  .module-title:hover { background: var(--surface-soft); }
  .folder-icon { color: var(--brand); flex-shrink: 0; }
  .module-lessons {
    list-style: none;
    padding: .25rem 0 .25rem .75rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: .2rem;
  }
  .lesson-link {
    display: flex;
    align-items: center;
    gap: .5rem;
    padding: .45rem .65rem;
    border-radius: .55rem;
    color: var(--muted);
    font-size: .8rem;
    line-height: 1.4;
    transition: all .15s ease;
  }
  .lesson-link:hover {
    color: var(--text);
    background: var(--surface-soft);
  }
  .lesson-link.active {
    color: var(--brand);
    background: var(--brand-soft);
    font-weight: 600;
    border-left: 3px solid var(--brand);
  }
  .lesson-bullet {
    font-size: .75rem;
    flex-shrink: 0;
  }
  .lesson-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Lesson Main */
  .lesson-main { min-width: 0; }
  .lesson-main h1 {
    margin: .35rem 0 .5rem;
    font-size: clamp(2rem, 3.2vw, 2.5rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -.03em;
    color: var(--text);
  }
  .lesson-lead {
    margin: 0 0 .85rem;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.65;
  }
  .author-meta-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.15rem;
    border-bottom: 1px solid var(--line);
    margin-bottom: 1.25rem;
  }
  .detail-actions {
    display: flex;
    align-items: center;
    gap: .55rem;
  }
  .btn-action {
    min-height: 2.25rem;
    padding: .35rem .85rem;
    font-size: .82rem;
    border-radius: .55rem;
  }
  .lesson-cover {
    width: 100%;
    aspect-ratio: 16 / 5;
    object-fit: cover;
    border-radius: 1rem;
    margin: .5rem 0 1.75rem;
    border: 1px solid var(--line);
    box-shadow: var(--shadow-sm);
  }

  /* Prev/Next Pagination */
  .lesson-pagination {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 2.5rem;
  }
  .pagination-card {
    display: flex;
    flex-direction: column;
    gap: .25rem;
    padding: 1rem 1.25rem;
    border-radius: .85rem;
    transition: all .18s ease;
  }
  .pagination-card:hover {
    border-color: var(--brand-soft-border);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }
  .pagination-card.next { text-align: right; }
  .pagination-sub {
    display: inline-flex;
    align-items: center;
    gap: .3rem;
    color: var(--muted);
    font-size: .78rem;
    font-weight: 500;
  }
  .pagination-card.next .pagination-sub { justify-content: flex-end; }
  .pagination-title {
    font-size: .92rem;
    font-weight: 700;
    color: var(--text);
  }

  @media (max-width: 1180px) {
    .lesson-grid { grid-template-columns: 260px minmax(0, 1fr); }
    .lesson-grid > .toc-panel { display: none; }
  }
  @media (max-width: 820px) {
    .lesson-grid { grid-template-columns: 1fr; }
    .course-sidebar { display: none; }
    .mobile-course { display: block; }
  }
</style>
