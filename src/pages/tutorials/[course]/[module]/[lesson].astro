---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { CalendarDays, CheckCircle2, ChevronLeft, ChevronRight, Clock3, Home, ListChecks } from 'lucide-astro';
import Picture from '../../../../components/ResponsiveImage.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Giscus from '../../../../components/Giscus.astro';
import ReadingProgress from '../../../../components/ReadingProgress.astro';
import ShareButton from '../../../../components/ShareButton.astro';
import { lessonHref, formatDate, publicOnly } from '../../../../lib/content';
import { imageFor } from '../../../../lib/images';

export async function getStaticPaths() {
  return (await getCollection('lessons')).filter(publicOnly).map((entry) => ({ params: { course: entry.data.course, module: entry.data.module, lesson: entry.id.split('/').at(-1) }, props: { entry } }));
}
const { entry } = Astro.props as { entry: CollectionEntry<'lessons'> };
const allLessons = (await getCollection('lessons')).filter(publicOnly).filter((lesson) => lesson.data.course === entry.data.course).sort((a, b) => a.data.order - b.data.order);
const course = (await getCollection('courses')).find((item) => item.id === entry.data.course);
if (!course) throw new Error(`Course not found: ${entry.data.course}`);
const currentIndex = allLessons.findIndex((lesson) => lesson.id === entry.id);
const previous = allLessons[currentIndex - 1];
const next = allLessons[currentIndex + 1];
const modules = [...new Set(allLessons.map((lesson) => lesson.data.module))].map((module) => ({ id: module, title: allLessons.find((lesson) => lesson.data.module === module)?.data.moduleTitle ?? module, lessons: allLessons.filter((lesson) => lesson.data.module === module) }));
const { Content, headings } = await render(entry);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const base = import.meta.env.BASE_URL;
const progressKey = 'aizhixing:tutorial-progress:v1';
---
<BaseLayout title={`${entry.data.title} · ${course.data.title}`} description={entry.data.description}>
  <ReadingProgress />
  <div class="container lesson-grid">
    <aside class="course-sidebar surface" aria-label="课程章节">
      <a class="course-back" href={`${base}tutorials/`}><ChevronLeft size={15} />返回教程列表</a>
      <Picture src={imageFor(course.data.cover)} alt={course.data.coverAlt} formats={['avif','webp']} widths={[220,360]} sizes="260px" />
      <h2>{course.data.title}</h2><p>{course.data.description}</p>
      <div class="course-progress"><span><ListChecks size={14} />学习进度</span><strong data-progress-label>0 / {allLessons.length}</strong></div><div class="progress-track"><span data-progress-bar></span></div>
      <div class="course-tree">{modules.map((group, index) => <section><h3>{index + 1}. {group.title}</h3><ol>{group.lessons.map((lesson) => <li><a class:list={['lesson-link', { active: lesson.id === entry.id }]} href={lessonHref(lesson, base)} data-lesson-link={lesson.id}><span data-check>○</span>{lesson.data.title}</a></li>)}</ol></section>)}</div>
    </aside>

    <article class="lesson-main" data-pagefind-body>
      <span class="sr-only" data-pagefind-filter="type:教程">教程</span><span class="sr-only" data-pagefind-filter={`category:${course.data.category}`}>{course.data.category}</span>
      <nav class="breadcrumbs" aria-label="面包屑" data-pagefind-ignore><a href={base}><Home size={13} />首页</a><span>/</span><a href={`${base}tutorials/`}>教程</a><span>/</span><span>{course.data.title}</span></nav>
      <div class="eyebrow">{course.data.title} · {entry.data.moduleTitle}</div><h1 data-pagefind-meta="title">{entry.data.title}</h1><p class="lesson-lead" data-pagefind-meta="description">{entry.data.description}</p>
      <div class="meta" data-pagefind-ignore><span><CalendarDays size={15} />{formatDate(entry.data.publishedAt)}</span><span><Clock3 size={15} />约 {entry.data.duration} 分钟阅读</span><span>第 {currentIndex + 1} / {allLessons.length} 节</span></div>
      <div class="tag-row lesson-tags">{entry.data.tags.map((tag) => <span class="pill" data-pagefind-filter={`tag:${tag}`}>{tag}</span>)}</div>
      <div class="detail-actions" data-pagefind-ignore><ShareButton /><button class="btn btn-primary" type="button" data-complete><CheckCircle2 size={17} /><span>完成本节</span></button></div>

      <details class="mobile-course surface" data-pagefind-ignore><summary>课程目录与进度 <strong data-progress-label>0 / {allLessons.length}</strong></summary><div class="progress-track"><span data-progress-bar></span></div><div class="course-tree">{modules.map((group, index) => <section><h3>{index + 1}. {group.title}</h3><ol>{group.lessons.map((lesson) => <li><a class:list={['lesson-link', { active: lesson.id === entry.id }]} href={lessonHref(lesson, base)} data-lesson-link={lesson.id}><span data-check>○</span>{lesson.data.title}</a></li>)}</ol></section>)}</div></details>
      {toc.length > 0 && <details class="mobile-toc surface" data-pagefind-ignore><summary>本节目录</summary><ol>{toc.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></details>}
      <Picture class="lesson-cover" src={imageFor(course.data.cover)} alt={course.data.coverAlt} formats={['avif','webp']} widths={[720,1100]} sizes="(max-width:1180px) 100vw, 820px" />
      <div class="prose"><Content /></div>
      <nav class="lesson-pagination" aria-label="上下节导航" data-pagefind-ignore>{previous ? <a class="surface" href={lessonHref(previous, base)}><small>上一节</small><span><ChevronLeft size={17} />{previous.data.title}</span></a> : <span />}{next ? <a class="surface" href={lessonHref(next, base)} data-next><small>下一节</small><span>{next.data.title}<ChevronRight size={17} /></span></a> : <a class="surface" href={`${base}tutorials/`} data-next><small>课程完成</small><span>返回教程列表<ChevronRight size={17} /></span></a>}</nav>
      <Giscus />
    </article>

    <aside class="toc-panel" aria-label="本节目录"><div class="reading-widget"><header><span>阅读进度</span><strong data-reading-label>0%</strong></header><div><span data-reading-track></span></div></div><h2>本节目录</h2><ol>{toc.map((heading) => <li style={`padding-left:${(heading.depth - 2) * .75}rem`}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></aside>
  </div>
</BaseLayout>

<script is:inline define:vars={{ progressKey, courseId: entry.data.course, lessonId: entry.id, total: allLessons.length }}>
  (() => {
    let all = {}; try { all = JSON.parse(localStorage.getItem(progressKey) || '{}'); } catch { all = {}; }
    const completed = new Set(Array.isArray(all[courseId]) ? all[courseId] : []);
    const render = () => {
      document.querySelectorAll('[data-lesson-link]').forEach((link) => { const done = completed.has(link.getAttribute('data-lesson-link')); const check = link.querySelector('[data-check]'); if (check) check.textContent = done ? '✓' : '○'; });
      document.querySelectorAll('[data-progress-label]').forEach((label) => { label.textContent = `${completed.size} / ${total}`; });
      document.querySelectorAll('[data-progress-bar]').forEach((bar) => { bar.style.width = `${Math.min(100, completed.size / total * 100)}%`; });
      const button = document.querySelector('[data-complete]'); if (button) { const done = completed.has(lessonId); button.classList.toggle('is-done', done); const text = button.querySelector('span'); if (text) text.textContent = done ? '已完成' : '完成本节'; }
    };
    const save = () => { all[courseId] = [...completed]; localStorage.setItem(progressKey, JSON.stringify(all)); render(); };
    document.querySelector('[data-complete]')?.addEventListener('click', () => { completed.add(lessonId); save(); });
    document.querySelectorAll('[data-next]').forEach((link) => link.addEventListener('click', () => { completed.add(lessonId); all[courseId] = [...completed]; localStorage.setItem(progressKey, JSON.stringify(all)); }));
    render();
  })();
</script>

<style>
  .lesson-grid { display: grid; grid-template-columns: 275px minmax(0, 1fr) 245px; gap: 1.45rem; align-items: start; padding-block: 1rem 3rem; }
  .course-sidebar { position: sticky; top: 5.5rem; max-height: calc(100vh - 6.5rem); overflow: auto; padding: .85rem; }
  .course-back { display: inline-flex; align-items: center; gap: .2rem; color: var(--brand); font-size: .75rem; font-weight: 750; }
  .course-sidebar :global(picture) { margin: .7rem 0; }
  .course-sidebar :global(img) { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: .5rem; }
  .course-sidebar h2 { margin: 0; font-size: .96rem; line-height: 1.4; }
  .course-sidebar > p { margin: .25rem 0 .7rem; color: var(--muted); font-size: .72rem; }
  .course-progress { display: flex; align-items: center; justify-content: space-between; color: var(--muted); font-size: .72rem; }
  .course-progress span { display: inline-flex; align-items: center; gap: .3rem; }
  .progress-track { height: 5px; margin: .4rem 0 .75rem; overflow: hidden; border-radius: 99px; background: var(--surface-soft); }
  .progress-track span { display: block; width: 0; height: 100%; background: var(--brand); transition: width .2s ease; }
  .course-tree section + section { margin-top: .75rem; }
  .course-tree h3 { margin: 0 0 .3rem; font-size: .75rem; }
  .course-tree ol { display: grid; gap: .15rem; margin: 0; padding: 0; list-style: none; }
  .lesson-link { display: grid; grid-template-columns: 1rem 1fr; gap: .3rem; padding: .4rem .45rem; border-radius: .45rem; color: var(--muted); font-size: .72rem; line-height: 1.45; }
  .lesson-link:hover, .lesson-link.active { color: var(--brand); background: var(--brand-soft); }
  .lesson-main { min-width: 0; }
  .lesson-main h1 { margin: .25rem 0 .35rem; font-size: clamp(2rem, 3.3vw, 2.65rem); line-height: 1.17; letter-spacing: -.035em; }
  .lesson-lead { margin: 0 0 .65rem; color: var(--muted); }
  .lesson-tags { margin-top: .6rem; }
  .lesson-cover { width: 100%; aspect-ratio: 16 / 3.5; object-fit: cover; border-radius: .6rem; margin: .2rem 0 .8rem; }
  .mobile-course { display: none; margin: .7rem 0; padding: .7rem .8rem; }
  .mobile-course summary { display: flex; justify-content: space-between; cursor: pointer; font-size: .82rem; font-weight: 800; }
  .lesson-pagination { display: grid; grid-template-columns: 1fr 1fr; gap: .65rem; margin-top: 1.5rem; }
  .lesson-pagination a { padding: .65rem .75rem; }
  .lesson-pagination small { display: block; color: var(--muted); font-size: .68rem; }
  .lesson-pagination span { display: flex; align-items: center; justify-content: space-between; font-size: .8rem; font-weight: 750; }
  .lesson-pagination a:last-child { text-align: right; }
  .is-done { background: #0a9c72; }
  .breadcrumbs a { display: inline-flex; align-items: center; gap: .25rem; }
  @media (max-width: 1180px) { .lesson-grid { grid-template-columns: 250px minmax(0,1fr); } .lesson-grid > .toc-panel { display: none; } }
  @media (max-width: 820px) { .lesson-grid { grid-template-columns: 1fr; gap: .65rem; } .course-sidebar { display: none; } .mobile-course { display: block; } }
  @media (max-width: 560px) { .lesson-cover { aspect-ratio: 16 / 8; } .lesson-pagination { grid-template-columns: 1fr; } }
</style>
